# DVLA_API_KEY: Your DVLA Open Data Portal API key for real-time vehicle lookups.
# Get one from: https://developer-portal.driver-vehicle-licensing.api.gov.uk/
DVLA_API_KEY="hRo51bg9sP91LZt4EE0eL4G1DlJzx8cs1dmlUDbi"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_FIREBASE_VAPID_KEY: Required for FCM push notifications.
VITE_FIREBASE_VAPID_KEY=""

# FCM Server Variables (Required for Cloudflare/Server-side Push)
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# Paystack Payment Gateway Variables (Live Checkout)
PAYSTACK_SECRET_KEY=""
VITE_PAYSTACK_PUBLIC_KEY=""

# Paddle Billing (Replaces Paystack)
PADDLE_CLIENT_TOKEN="live_8a3b7e2f1c4d5e6f7a8b9c0d1e2f3a4b"
PADDLE_WEBHOOK_SECRET=""
PADDLE_ENVIRONMENT="sandbox"



# Brevo API key for transactional emails (custom verification links)
BREVO_API_KEY=""
