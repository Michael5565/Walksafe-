{
  "entities": {
    "company": {
      "title": "Company",
      "description": "A fleet operating company",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "oLicence": { "type": "string" },
        "plan": { "type": "string" },
        "vehicleLimit": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "vehicle": {
      "title": "Vehicle",
      "description": "A commercial vehicle",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "registration": { "type": "string" },
        "make": { "type": "string" },
        "model": { "type": "string" },
        "year": { "type": "number" },
        "colour": { "type": "string" },
        "type": { "type": "string" },
        "motExpiry": { "type": "string" },
        "taxExpiry": { "type": "string" },
        "isActive": { "type": "boolean" },
        "isGrounded": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "registration"]
    },
    "driver": {
      "title": "Driver",
      "description": "A vehicle driver",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "pin": { "type": "string" },
        "defaultVehicleId": { "type": "string" },
        "assignedVehicleIds": { "type": "array" },
        "installToken": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "fullName"]
    },
    "check": {
      "title": "Walkaround Check",
      "description": "A daily vehicle inspection result",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "vehicleId": { "type": "string" },
        "driverId": { "type": "string" },
        "companyId": { "type": "string" },
        "startedAt": { "type": "string" },
        "completedAt": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "result": { "type": "string" },
        "driverSignature": { "type": "string" },
        "checkDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" }
      },
      "required": ["id", "vehicleId", "driverId", "companyId"]
    },
    "defect": {
      "title": "Defect",
      "description": "A reported vehicle defect",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "checkId": { "type": "string" },
        "vehicleId": { "type": "string" },
        "companyId": { "type": "string" },
        "itemKey": { "type": "string" },
        "itemLabel": { "type": "string" },
        "severity": { "type": "string" },
        "description": { "type": "string" },
        "photoUrl": { "type": "string" },
        "status": { "type": "string" },
        "engineerName": { "type": "string" },
        "repairDescription": { "type": "string" },
        "partsUsed": { "type": "string" },
        "repairCompletedAt": { "type": "string" },
        "engineerSignature": { "type": "string" },
        "closedBy": { "type": "string" },
        "closedAt": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "checkId", "vehicleId", "companyId"]
    },
    "pushSubscription": {
      "title": "Push Subscription",
      "description": "FCM or Web Push registration token",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "companyId": { "type": "string" },
        "userId": { "type": "string" },
        "platform": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["token", "companyId"]
    }
  },
  "firestore": {
    "/companies/{companyId}": {
      "schema": "company",
      "description": "Company document"
    },
    "/companies/{companyId}/vehicles/{vehicleId}": {
      "schema": "vehicle",
      "description": "Vehicles belonging to a company"
    },
    "/companies/{companyId}/drivers/{driverId}": {
      "schema": "driver",
      "description": "Drivers belonging to a company"
    },
    "/companies/{companyId}/checks/{checkId}": {
      "schema": "check",
      "description": "Walkaround checks"
    },
    "/companies/{companyId}/defects/{defectId}": {
      "schema": "defect",
      "description": "Defects reported for a company"
    },
    "/push_subscriptions/{tokenId}": {
      "schema": "pushSubscription",
      "description": "Device push registration tokens"
    }
  }
}
