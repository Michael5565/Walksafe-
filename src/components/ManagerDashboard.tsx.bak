                      </div>

                      <ul className="text-[11px] text-slate-600 gap-1.5 flex flex-col border-t border-slate-100 pt-3">
                        <li className="flex items-center gap-1.5">✓ Limit 1 Vehicle</li>
                        <li className="flex items-center gap-1.5">✓ Full DVSA Compliance Log</li>
                        <li className="flex items-center gap-1.5">✓ Dynamic Web PDF Export</li>
                        <li className="flex items-center gap-1.5 text-slate-400">✗ Push Alerts</li>
                      </ul>
                    </div>

                    <button
                      type="button"
                      disabled={company.plan === 'owner-driver'}
                      onClick={() => handlePlanUpgrade('owner-driver', 1)}
                      className={`w-full mt-6 py-2 px-3 text-xs font-bold rounded-xl transition-all ${
                        company.plan === 'owner-driver'
                          ? 'bg-amber-100 text-amber-800 border-0 cursor-default'
                          : 'bg-slate-900 text-white hover:bg-slate-800 cursor-pointer'
                      }`}
                    >
                      {company.plan === 'owner-driver' ? 'Current Active' : 'Switch Solo'}
                    </button>
                  </div>

                  {/* Option 2: Starter */}
                  <div className={`p-5 rounded-2xl border flex flex-col justify-between transition-all ${
                    company.plan === 'starter' 
                      ? 'border-amber-500 bg-amber-50/10 shadow-sm ring-2 ring-amber-500/20' 
                      : 'border-slate-200 hover:border-slate-300 bg-white'
                  }`}>
                    <div>
                      <span className="text-[9px] font-mono uppercase bg-amber-100 text-amber-800 font-bold px-1.5 py-0.5 rounded">Trial Fleet</span>
                      <h5 className="font-display text-base font-bold text-slate-900 mt-2">Starter Fleet</h5>
                      <span className="text-slate-400 text-xs block mt-1">Up to 3 vehicles</span>
                      
                      <div className="mt-4 mb-3">
                        <span className="font-display text-2xl font-black text-slate-900">£14.99</span>
                        <span className="text-slate-500 text-xs"> / mo</span>
                      </div>

                      <ul className="text-[11px] text-slate-600 gap-1.5 flex flex-col border-t border-slate-100 pt-3">
                        <li className="flex items-center gap-1.5">✓ Limit 3 Vehicles</li>
                        <li className="flex items-center gap-1.5">✓ Live Push Alerts</li>
                        <li className="flex items-center gap-1.5">✓ DVLA Registrations Lookup</li>
                        <li className="flex items-center gap-1.5 text-slate-400">✗ Bulk ZIP Archive</li>
                      </ul>
                    </div>

                    <button
                      type="button"
                      disabled={company.plan === 'starter'}
                      onClick={() => handlePlanUpgrade('starter', 3)}
                      className={`w-full mt-6 py-2 px-3 text-xs font-bold rounded-xl transition-all ${
                        company.plan === 'starter'
                          ? 'bg-amber-100 text-amber-800 border-0 cursor-default'
                          : 'bg-slate-900 text-white hover:bg-slate-800 cursor-pointer'
                      }`}
                    >
                      {company.plan === 'starter' ? 'Current Active' : 'Switch Starter'}
                    </button>
                  </div>

                  {/* Option 3: Growth */}
                  <div className={`p-5 rounded-2xl border flex flex-col justify-between transition-all relative ${
                    company.plan === 'growth' 
                      ? 'border-amber-500 bg-amber-50/10 shadow-sm ring-2 ring-amber-500/20' 
                      : 'border-slate-200 hover:border-slate-300 bg-white'
                  }`}>
                    <div className="absolute top-3 right-3 bg-emerald-500 text-white text-[8px] font-black font-mono px-1.5 py-0.5 rounded-full uppercase tracking-wider animate-pulse">
                      Popular
                    </div>
                    <div>
                      <span className="text-[9px] font-mono uppercase bg-emerald-100 text-emerald-800 font-bold px-1.5 py-0.5 rounded">Pro Fleet</span>
                      <h5 className="font-display text-base font-bold text-slate-900 mt-2">Growth Fleet Pro</h5>
                      <span className="text-slate-400 text-xs block mt-1">Up to 10 vehicles</span>
                      
                      <div className="mt-4 mb-3">
                        <span className="font-display text-2xl font-black text-slate-900">£34.99</span>
                        <span className="text-slate-500 text-xs"> / mo</span>
                      </div>

                      <ul className="text-[11px] text-slate-600 gap-1.5 flex flex-col border-t border-slate-100 pt-3">
                        <li className="flex items-center gap-1.5">✓ Limit 10 Vehicles</li>
                        <li className="flex items-center gap-1.5">✓ Bulk CSV & PDF Archiving</li>
                        <li className="flex items-center gap-1.5">✓ Live Support Live Desk Access</li>
                        <li className="flex items-center gap-1.5">✓ Region Broadcasting</li>
                      </ul>
                    </div>

                    <button
                      type="button"
                      disabled={company.plan === 'growth'}
                      onClick={() => handlePlanUpgrade('growth', 10)}
                      className={`w-full mt-6 py-2 px-3 text-xs font-bold rounded-xl transition-all ${
                        company.plan === 'growth'
                          ? 'bg-amber-100 text-amber-800 border-0 cursor-default'
                          : 'bg-slate-900 text-white hover:bg-slate-800 cursor-pointer'
                      }`}
                    >
                      {company.plan === 'growth' ? 'Current Active' : 'Upgrade Pro ⚡'}
                    </button>
                  </div>

                  {/* Option 4: Enterprise Scale */}
                  <div className={`p-5 rounded-2xl border flex flex-col justify-between transition-all ${
                    company.plan === 'enterprise' 
                      ? 'border-amber-500 bg-amber-50/10 shadow-sm ring-2 ring-amber-500/20' 
                      : 'border-slate-200 hover:border-slate-300 bg-white'
                  }`}>
                    <div>
                      <span className="text-[9px] font-mono uppercase bg-indigo-100 text-indigo-850 font-bold px-1.5 py-0.5 rounded">Enterprise level</span>
                      <h5 className="font-display text-base font-bold text-slate-900 mt-2">Unlimited Fleet</h5>
                      <span className="text-slate-400 text-xs block mt-1">99 assets & integrations</span>
                      
                      <div className="mt-4 mb-3">
                        <span className="font-display text-2xl font-black text-blue-600">Contact Us</span>
                      </div>

                      <ul className="text-[11px] text-slate-600 gap-1.5 flex flex-col border-t border-slate-100 pt-3">
                        <li className="flex items-center gap-1.5">✓ Limit 99 Vehicles</li>
                        <li className="flex items-center gap-1.5">✓ Custodial compliance locks</li>
                        <li className="flex items-center gap-1.5">✓ Secure Dedicated Cloud Storage</li>
                        <li className="flex items-center gap-1.5">✓ API Hook Webhooks Support</li>
                      </ul>
                    </div>

                    <button
                      type="button"
                      onClick={() => handlePlanUpgrade('enterprise', 99)}
                      className="w-full mt-6 py-2 px-3 text-xs font-bold rounded-xl transition-all bg-blue-600 text-white hover:bg-blue-700 cursor-pointer"
                    >
                      {company.plan === 'enterprise' ? 'Active Enterprise Support ✉' : 'Contact Us ✉'}
                    </button>
                  </div>

                </div>
              </div>

              {/* INTERACTIVE FLEET COST & PAYMENT FEE OPTIMIZER CALCULATOR */}
              <div className="bg-slate-900 text-slate-100 rounded-[32px] border border-slate-800 shadow-xl p-6 md:p-8">
                <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6 pb-6 border-b border-slate-800">
                  <div>
                    <span className="text-amber-500 text-[10px] uppercase font-mono font-black tracking-widest block mb-1">Fee Optimization Suite</span>
                    <h3 className="font-display text-xl font-bold text-white uppercase">
                      📊 Direct Debit vs Paystack Cost Optimizer
                    </h3>
                    <p className="text-xs text-slate-400 mt-1 leading-normal max-w-xl">
                      Find your absolute lowest payment overhead. Slide your target fleet size below to see how standard card transaction fees compare against automated Direct Debit CAPS.
                    </p>
                  </div>
                  <div className="bg-slate-950/80 border border-slate-800 rounded-2xl px-4 py-2 text-right">
                    <span className="text-[9px] uppercase tracking-wider text-slate-500 font-mono">Simulated Target Fleet</span>
                    <div className="flex items-baseline gap-1.5 justify-end">
                      <span className="text-2xl font-black text-amber-500">{calcVehicles}</span>
                      <span className="text-slate-400 text-xs">Vehicles</span>
                    </div>
                  </div>
                </div>

                <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
                  {/* Left Parameter Column */}
                  <div className="space-y-4 lg:col-span-1">
                    <div>
                      <label className="text-[10px] text-slate-400 uppercase font-mono font-bold tracking-wider block mb-2">
                        How many vehicles are in your fleet?
                      </label>
                      <input 
                        type="range"
                        min={1}
                        max={99}
                        value={calcVehicles}
                        onChange={(e) => setCalcVehicles(Number(e.target.value))}
                        className="w-full accent-amber-500 h-2 bg-slate-800 rounded-full appearance-none cursor-pointer"
                      />
                      <div className="flex justify-between text-[10px] text-slate-500 font-mono mt-1">
                        <span>1 (Solo)</span>
                        <span>45 (Fleet)</span>
                        <span>99 (Unlimited)</span>
                      </div>
                    </div>

                    <div className="bg-slate-950/50 p-4 rounded-2xl border border-slate-800 space-y-1 text-left">
                      <span className="text-[9px] text-indigo-400 font-mono font-bold uppercase tracking-wider">Dynamic License Tier Suggestion</span>
                      <h4 className="text-xs font-bold text-slate-200">
                        {calcVehicles === 1 ? "Solo Owner-Driver (£4.99/mo)" : calcVehicles <= 3 ? "Starter Fleet (£14.99/mo)" : calcVehicles <= 10 ? "Growth Fleet Pro (£34.99/mo)" : "Enterprise Scale (£84.99/mo)"}
                      </h4>
                      <p className="text-[11px] text-slate-500 leading-normal">
                        Matches your simulated capacity profile with the most cost-effective membership tier.
                      </p>
                    </div>
                  </div>

                  {/* Middle and Right Comparison Grid */}
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4 lg:col-span-2 text-left">
                    
                    {/* Method A: Paystack CC */}
                    <div className="bg-slate-950/40 border border-slate-800 rounded-2xl p-5 flex flex-col justify-between">
                      <div>
                        <div className="flex justify-between items-center pb-3 border-b border-slate-850">
                          <span className="text-[10px] font-mono font-black uppercase text-rose-400">Credit / Debit Card</span>
                          <span className="text-[10px] font-mono bg-rose-500/10 text-rose-400 px-2 py-0.5 rounded">Paystack Gateway</span>
                        </div>

                        <div className="mt-4 space-y-2">
                          <div className="flex justify-between text-xs">
                            <span className="text-slate-400">Software Fee:</span>
                            <span className="text-slate-200">
                              £{calcVehicles === 1 ? "4.99" : calcVehicles <= 3 ? "14.99" : calcVehicles <= 10 ? "34.99" : "84.99"}
                            </span>
                          </div>
                          <div className="flex justify-between text-xs">
                            <span className="text-slate-400">Paystack Flat rate:</span>
                            <span className="text-slate-200">1.4% + 20p</span>
                          </div>
                          <div className="flex justify-between text-xs font-bold pt-2 border-t border-slate-850">
                            <span className="text-rose-400">Merchant Fees:</span>
                            <span className="text-rose-400 text-sm">
                              £{((calcVehicles === 1 ? 4.99 : calcVehicles <= 3 ? 14.99 : calcVehicles <= 10 ? 34.99 : 84.99) * 0.014 + 0.20).toFixed(2)}
                            </span>
                          </div>
                        </div>
                      </div>

                      <div className="pt-4 mt-4 border-t border-slate-850 text-[11px] text-slate-500 leading-normal">
                        Credit cards offer fast checkout but introduce friction and recurring transaction percent losses on large fleetholder memberships.
                      </div>
                    </div>

                    {/* Method B: Direct Debit (BACS) */}
                    <div className="bg-teal-950/10 border border-teal-500/20 rounded-2xl p-5 flex flex-col justify-between relative overflow-hidden">
                      <div className="absolute top-0 right-0 bg-teal-500 text-slate-950 text-[8px] font-bold font-mono px-2 py-0.5 uppercase">
                        Recommended
                      </div>
                      
                      <div>
                        <div className="flex justify-between items-center pb-3 border-b border-teal-900/30">
                          <span className="text-[10px] font-mono font-black uppercase text-teal-400">BACS Direct Debit</span>
                          <span className="text-[10px] font-mono bg-teal-500/15 text-teal-400 px-2 py-0.5 rounded">Bank-To-Bank</span>
                        </div>

                        <div className="mt-4 space-y-2">
                          <div className="flex justify-between text-xs">
                            <span className="text-slate-400">Software Fee:</span>
                            <span className="text-slate-200">
                              £{calcVehicles === 1 ? "4.99" : calcVehicles <= 3 ? "14.99" : calcVehicles <= 10 ? "34.99" : "84.99"}
                            </span>
                          </div>
                          <div className="flex justify-between text-xs">
                            <span className="text-slate-400">BACS Flat rate:</span>
                            <span className="text-slate-200">1.0% (Cap £2 max)</span>
                          </div>
                          <div className="flex justify-between text-xs font-bold pt-2 border-t border-teal-900/30">
                            <span className="text-teal-400">Merchant Fees:</span>
                            <span className="text-teal-400 text-sm">
                              £{Math.min(2.0, (calcVehicles === 1 ? 4.99 : calcVehicles <= 3 ? 14.99 : calcVehicles <= 10 ? 34.99 : 84.99) * 0.01).toFixed(2)}
                            </span>
                          </div>
                        </div>
                      </div>

                      <div className="pt-4 mt-4 border-t border-teal-900/30 text-[11px] text-teal-400/90 leading-normal font-sans">
                        Save <strong className="text-white">
                          {(((calcVehicles === 1 ? 4.99 : calcVehicles <= 3 ? 14.99 : calcVehicles <= 10 ? 34.99 : 84.99) * 0.014 + 0.20) > Math.min(2.0, (calcVehicles === 1 ? 4.99 : calcVehicles <= 3 ? 14.99 : calcVehicles <= 10 ? 34.99 : 84.99) * 0.01)) ? "up to 55%" : "over cards"}
                        </strong> on transactions! Automatic bank drafts guarantee absolute security safeguards and eliminate credit card expiration failure points.
                      </div>
                    </div>

                  </div>
                </div>
              </div>

              {/* Billing Payment Update Inline Form details */}
              <div className="bg-white rounded-[32px] border border-slate-200 shadow-xs p-6 max-w-lg">
                <h4 className="font-display font-bold text-base text-slate-900 mb-1 uppercase">
                  💳 Customer Billing Portal
                </h4>
                <p className="text-xs text-slate-400 mt-1 mb-4 leading-normal">
                  Your billing information and corporate cards are managed securely via the Paystack Customer Portal. WalkSafe does not store or process your card details directly.
                </p>

                <div className="pt-2">
                  <a
                    href="mailto:support@getwalksafe.co.uk?subject=Billing Portal Access Request"
                    className="inline-block w-full bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs py-3 px-4 rounded-xl transition-all cursor-pointer font-mono uppercase tracking-wider text-center"
                  >
                    Manage via Paystack Portal ➔
                  </a>
                </div>
              </div>

              {/* Statement History and Download Table */}
              <div className="bg-white rounded-[32px] border border-slate-200 shadow-xs p-6 overflow-hidden">
                <div className="mb-4">
                  <h4 className="font-display font-black text-lg text-slate-900 uppercase">
                    📁 Statement Archives & Payment VAT Receipts
                  </h4>
                  <p className="text-xs text-slate-400 mt-0.5 font-mono">
                    Download legally binding corporate VAT receipts on-demand.
                  </p>
                </div>

                <div className="overflow-x-auto">
                  <table className="w-full text-xs text-left text-slate-700">
                    <thead className="bg-slate-50/50 uppercase font-mono text-[9px] text-slate-450 border-b border-slate-100">
                      <tr>
                        <th className="py-3 px-4">Statement #</th>
                        <th className="py-3 px-4">Billing Date</th>
                        <th className="py-3 px-4">Allowance Plan</th>
                        <th className="py-3 px-4">Billed Amount</th>
                        <th className="py-3 px-4">Card Used</th>
                        <th className="py-3 px-4 text-center">Receipt PDF</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-slate-100 font-medium">
                      {mockInvoices.map((inv) => (
                        <tr key={inv.invoiceId} className="hover:bg-slate-50/20">
                          <td className="py-3 px-4 font-mono font-bold text-slate-800">{inv.invoiceId}</td>
                          <td className="py-3 px-4 text-slate-500">{inv.issueDate}</td>
                          <td className="py-3 px-4 font-bold text-indigo-700 uppercase font-mono">{inv.planName}</td>
                          <td className="py-3 px-4 text-slate-800">{inv.amount}</td>
                          <td className="py-3 px-4 text-slate-500 font-mono">Visa •• {inv.paymentMethod}</td>
                          <td className="py-3 px-4 text-center">
                            <button
                              type="button"
                              onClick={() => triggerDownloadInvoice(inv)}
                              className="inline-flex items-center gap-1.5 bg-slate-105 hover:bg-slate-200 text-slate-800 font-mono font-bold text-[10px] px-3 py-1.5 rounded-lg transition-colors cursor-pointer"
                            >
                              <Download className="w-3.5 h-3.5 text-amber-500" /> DOWNLOAD VAT RECEIPT (PDF)
                            </button>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>

            </div>
          )}


        </main>
      </div>

      {/* GLOBAL OVERLAY MODALS */}

      {/* GLOBAL OVERLAY MODALS */}
      
      {/* MODAL: Compliance Schedule */}
      {showSchModal && (
        <div className="fixed inset-0 bg-slate-950/70 backdrop-blur-sm flex items-center justify-center z-[100] p-4">
          <div className="bg-white rounded-[32px] w-full max-w-2xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
            <div className="bg-slate-900 px-8 py-6 text-white flex justify-between items-center shrink-0">
               <div className="flex items-center gap-3">
                 <div className="p-2 bg-amber-500 rounded-xl text-slate-950">
                    <Calendar className="w-5 h-5" />
                 </div>
                 <div>
                    <h4 className="font-display text-xl font-black uppercase tracking-tight">Compliance Scheduler</h4>
                    <p className="text-[10px] text-slate-400 font-mono uppercase tracking-widest mt-0.5">Asset Safety Planning Module</p>
                 </div>
               </div>
               <button onClick={() => setShowSchModal(false)} className="text-slate-400 hover:text-white p-2 hover:bg-slate-800 rounded-full transition-colors">
                 <X className="w-7 h-7" />
               </button>
            </div>
            <div className="p-8 overflow-y-auto">
              <ChecklistSchedulerForm 
                vehicles={vehicles} 
                drivers={drivers} 
                onSubmit={async (data) => {
                  await onAddSchedule(data);
                  setShowSchModal(false);
                }} 
              />
            </div>
          </div>
        </div>
      )}

      {/* ADD NEW DRIVER MODAL OVERLAY */}
      {showDrvModal && (
        <div className="fixed inset-0 bg-slate-950/70 backdrop-blur-xs flex items-center justify-center z-[100] p-4">
          <div className="bg-white rounded-3xl w-full max-w-lg shadow-2xl overflow-hidden flex flex-col">
            <div className="bg-slate-900 px-6 py-4 text-white flex justify-between items-center">
              <div className="flex items-center gap-2">
                <Users className="w-5 h-5 text-amber-500" />
                <h4 className="font-display text-xl font-bold">
                  {editingDriver ? "EDIT REGISTERED DRIVER CARD" : "ADD REGISTERED DRIVER CARD"}
                </h4>
              </div>
              <button onClick={() => { setShowDrvModal(false); resetDrvForm(); }} className="text-slate-400 hover:text-white p-1">
                <X className="w-6 h-6" />
              </button>
            </div>

            <form onSubmit={handleSaveDriver} className="p-6 flex flex-col gap-4 overflow-y-auto max-h-[500px]">
              
              <div className="text-xs flex flex-col gap-3">
                <div>
                  <label className="text-slate-400 uppercase tracking-wider block font-bold mb-1">Full Driver Name</label>
                  <input
                    type="text"
                    required
                    value={drvName}
                    onChange={(e) => setDrvName(e.target.value)}
                    placeholder="James Murphy"
                    className="w-full bg-slate-50 border border-slate-300 rounded p-2.5 text-slate-800 focus:outline-hidden focus:border-amber-500"
                  />
                </div>

                <div>
                  <label className="text-slate-400 uppercase tracking-wider block font-bold mb-1">Driver Work Email (Used for Login & Comms)</label>
                  <input
                    type="email"
                    required
                    value={drvEmail}
                    onChange={(e) => setDrvEmail(e.target.value)}
                    placeholder="driver@company.com"
                    className="w-full bg-slate-50 border border-slate-300 rounded p-2.5 text-slate-800 focus:outline-hidden focus:border-amber-500"
                  />
                </div>

                <div>
                  <label className="text-slate-400 uppercase tracking-wider block font-bold mb-1">Phone Number (For SMS Compliance Alerts)</label>
                  <input
                    type="tel"
                    required
                    value={drvPhone}
                    onChange={(e) => setDrvPhone(e.target.value)}
                    placeholder="+44 7700 900123"
                    className="w-full bg-slate-50 border border-slate-300 rounded p-2.5 text-slate-850 font-mono focus:outline-hidden"
                  />
                </div>

                <div className="grid grid-cols-2 gap-3.5">
                  <div>
                    <label className="text-slate-400 uppercase tracking-wider block font-bold mb-1">Operator 4-Digit PIN</label>
                    <input
                      type="text"
                      maxLength={4}
                      required
                      value={drvPin}
                      onChange={(e) => setDrvPin(e.target.value.replace(/\D/g, ''))}
                      placeholder="1234"
                      className="w-full bg-slate-50 border border-slate-300 rounded p-2.5 font-mono text-center text-lg font-bold text-slate-800 focus:outline-hidden focus:border-amber-500"
                    />
                  </div>

                  <div>
                    <label className="text-slate-400 uppercase tracking-wider block font-bold mb-1">Assigned Vehicle</label>
                    <CustomSelect
                      value={drvDefaultVeh}
                      onChange={(val) => setDrvDefaultVeh(val)}
                      placeholder="Choose default vehicle..."
                      options={[
                        { value: "", label: "Choose default vehicle..." },
                        ...vehicles.map(v => ({ value: v.id, label: `${v.registration} — ${v.make}` }))
                      ]}
                    />
                  </div>
                </div>

                {/* Generate installer link box */}
                <div className="mt-4 pt-4 border-t border-slate-100 bg-slate-50 p-3 rounded-xl">
                  <span className="text-[11px] font-bold text-slate-800 uppercase block tracking-wider font-mono">
                    ⚡ DRIVER INSTALLATION PWA LINK
                  </span>
                  
                  <div className="flex gap-2 mt-2">
                    <button
                      type="button"
                      onClick={generateDriverLinkPlaceholder}
                      className="bg-slate-900 text-white font-mono text-[11px] px-3 py-1.5 rounded font-bold shrink-0"
                    >
                      {drvInviteToken ? "RE-GENERATE TOKEN" : "GENERATE DRIVER LINK"}
                    </button>
                    <input
                      type="text"
                      readOnly
                      value={generatedLink}
                      placeholder="Click button left to create install path"
                      className="bg-white border border-slate-200 text-[11px] px-2.5 rounded font-mono text-slate-600 flex-1 focus:outline-hidden"
                    />
                  </div>
                </div>

              </div>

              <div className="flex gap-3 justify-end mt-4 pt-4 border-t border-slate-100">
                <button
                  type="button"
                  onClick={() => { setShowDrvModal(false); resetDrvForm(); }}
                  className="px-4 py-2 border border-slate-300 text-slate-700 bg-white font-display text-sm rounded-lg"
                  disabled={isSavingDriver}
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  disabled={isSavingDriver}
                  className={`px-6 py-2 bg-slate-900 border border-slate-850 hover:bg-slate-800 text-white font-display text-sm font-bold rounded-lg flex items-center gap-2 ${
                    isSavingDriver ? "opacity-60 cursor-not-allowed" : ""
                  }`}
                >
                  {isSavingDriver ? "Saving..." : editingDriver ? "Update Driver Card" : "Save Driver Card"}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* ADD NEW VEHICLE MODAL OVERLAY */}
      {showVehModal && (
        <div className="fixed inset-0 bg-slate-950/70 backdrop-blur-xs flex items-center justify-center z-[100] p-4">
          <div className="bg-white rounded-3xl w-full max-w-lg shadow-2xl overflow-hidden flex flex-col">
            <div className="bg-slate-900 px-6 py-4 text-white flex justify-between items-center">
              <div className="flex items-center gap-2">
                <Truck className="w-5 h-5 text-amber-500" />
                <h4 className="font-display text-xl font-bold">
                  {editingVehicle ? "EDIT COMPLIANT OPERATOR VEHICLE" : "ADD COMPLIANT OPERATOR VEHICLE"}
                </h4>
              </div>
              <button onClick={() => { setShowVehModal(false); resetVehForm(); }} className="text-slate-400 hover:text-white p-1">
                <X className="w-6 h-6" />
              </button>
            </div>

            <form onSubmit={handleSaveVehicle} className="p-6 flex flex-col gap-4 overflow-y-auto max-h-[500px]">
              
              {/* Live UK DVLA lookups widget */}
              <div className="bg-slate-50 rounded-xl p-4 border border-slate-200">
                <span className="text-xs font-bold text-slate-800 uppercase tracking-widest block font-mono">
                  ⚡ UK DVLA VEHICLE DATABASE SYNC
                </span>
                
                <div className="flex gap-2 mt-2">
                  <input
                    type="text"
                    value={vehReg}
                    onChange={(e) => setVehReg(e.target.value.toUpperCase())}
                    placeholder="e.g. WN69 UTY or SC21 KOP"
                    className="bg-white border border-slate-300 rounded px-3 py-1.5 text-xs flex-1 uppercase font-mono font-bold font-semibold tracking-wider placeholder:normal-case placeholder:font-sans focus:outline-hidden focus:border-amber-500"
                  />
                  <button
                    type="button"
                    onClick={handleDvlaLookup}
                    disabled={dvlaLoading}
                    className="bg-slate-900 border border-slate-880 hover:bg-slate-800 text-white font-mono text-[11px] px-3 rounded text-amber-500 font-bold shrink-0"
                  >
                    {dvlaLoading ? 'RETRIEVING...' : '[RETRIEVE DVLA DETAIL]'}
                  </button>
                </div>

                {dvlaSuccess && (
                  <div className="mt-2.5 text-[11px] text-emerald-700 bg-emerald-50 border border-emerald-100 p-2 rounded">
                    ✓ Found matching DVLA chassis register! Real MOT & Tax loaded onto controls below.
                  </div>
                )}
                {dvlaError && (
                  <div className="mt-2.5 text-[11px] text-red-600 bg-red-50 border border-red-100 p-2 rounded">
                    ⚠️ {dvlaError}
                  </div>
                )}
              </div>

              <div className="grid grid-cols-2 gap-3.5 text-xs">
                <div>
                  <label className="text-slate-400 uppercase tracking-wider block font-bold mb-1">Make</label>
                  <input
                    type="text"
                    required
                    value={vehMake}
                    onChange={(e) => setVehMake(e.target.value)}
                    className="w-full bg-slate-50 border border-slate-300 rounded p-2 text-slate-800 focus:outline-hidden focus:border-amber-500"
                  />
                </div>
                <div>
                  <label className="text-slate-400 uppercase tracking-wider block font-bold mb-1">Model Detail</label>
                  <input
                    type="text"
                    required
                    value={vehModel}
                    onChange={(e) => setVehModel(e.target.value)}
                    className="w-full bg-slate-50 border border-slate-300 rounded p-2 text-slate-800 focus:outline-hidden focus:border-amber-500"
                  />
                </div>
              </div>

              <div className="grid grid-cols-2 gap-3.5 text-xs">
                <div>
                  <label className="text-slate-400 uppercase tracking-wider block font-bold mb-1">Asset Year</label>
                  <input
                    type="number"
                    required
                    value={vehYear}
                    onChange={(e) => setVehYear(Number(e.target.value))}
                    className="w-full bg-slate-50 border border-slate-300 rounded p-2 text-slate-800 focus:outline-hidden focus:border-amber-500"
                  />
                </div>
                <div>
                  <label className="text-slate-400 uppercase tracking-wider block font-bold mb-1">Chassis Color</label>
                  <input
                    type="text"
                    required
                    value={vehColour}
                    onChange={(e) => setVehColour(e.target.value)}
                    className="w-full bg-slate-50 border border-slate-300 rounded p-2 text-slate-800 focus:outline-hidden focus:border-amber-500"
                  />
                </div>
              </div>

              <div>
                <label className="text-slate-400 uppercase tracking-wider block font-bold mb-1">Regulatory Vehicle Class</label>
                <CustomSelect
                  value={vehType}
                  onChange={(val) => setVehType(val as any)}
                  placeholder="Select classification..."
                  options={[
                    { value: "lgv", label: "Rigid Van (LGV)" },
                    { value: "hgv", label: "HGV Rigid Box" },
                    { value: "hgv_trailer", label: "Articulated Cab + Trailer (HGV)" }
                  ]}
                />
              </div>

              <div className="grid grid-cols-2 gap-3.5 text-xs">
                <div>
                  <label className="text-slate-400 uppercase tracking-wider block font-bold mb-1">MOT Roadworthy Expiry</label>
                  <input
                    type="date"
                    required
                    value={vehMot}
                    onChange={(e) => setVehMot(e.target.value)}
                    className="w-full bg-slate-50 border border-slate-300 rounded p-2 text-slate-850 font-mono focus:outline-hidden"
                  />
                </div>
                <div>
                  <label className="text-slate-400 uppercase tracking-wider block font-bold mb-1">Taxation Period Expire</label>
                  <input
                    type="date"
                    required
                    value={vehTax}
                    onChange={(e) => setVehTax(e.target.value)}
                    className="w-full bg-slate-50 border border-slate-300 rounded p-2 text-slate-850 font-mono focus:outline-hidden"
                  />
                </div>
              </div>

              <div className="flex gap-3 justify-end mt-4 pt-4 border-t border-slate-100">
                <button
                  type="button"
                  onClick={() => { setShowVehModal(false); resetVehForm(); }}
                  className="px-4 py-2 border border-slate-300 text-slate-700 bg-white font-display text-sm rounded-lg"
                  disabled={isSavingVehicle}
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  disabled={isSavingVehicle}
                  className={`px-6 py-2 bg-slate-900 border border-slate-850 hover:bg-slate-800 text-white font-display text-sm font-bold rounded-lg flex items-center gap-2 ${
                    isSavingVehicle ? "opacity-60 cursor-not-allowed" : ""
                  }`}
                >
                  {isSavingVehicle ? "Saving..." : editingVehicle ? "Update Vehicle Register" : "Save Vehicle Register"}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Detailed review checking item modal */}
      {viewingCheck && (
        <div className="fixed inset-0 bg-slate-950/70 backdrop-blur-xs flex items-center justify-center z-[100] p-4">
          <div className="bg-white rounded-3xl w-full max-w-xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
            <div className="bg-slate-900 px-6 py-4 text-white flex justify-between items-center shrink-0">
              <span className="font-display font-medium text-lg uppercase">Audit Trail Check Record Summary</span>
              <button onClick={() => setViewingCheck(null)} className="p-1 text-slate-400 hover:text-white"><X className="w-6 h-6" /></button>
            </div>

            <div className="p-6 flex-1 overflow-y-auto text-xs grid grid-cols-2 gap-4">
              
              <div className="col-span-2 bg-slate-50 p-3 rounded-xl border border-slate-200 grid grid-cols-2 gap-2 text-slate-900 font-mono">
                <div>
                  <span className="text-slate-400 block text-[10px]">VEHICLE</span>
                  <span className="font-bold text-sm tracking-wide bg-amber-400/90 py-0.5 px-2 text-black border border-black rounded inline-flex">{vehicles.find(v => v.id === viewingCheck.vehicleId)?.registration}</span>
                </div>
                <div>
                  <span className="text-slate-400 block text-[10px]">DRIVER PIN ENTRY</span>
                  <span className="font-bold text-slate-850 font-sans">{drivers.find(d => d.id === viewingCheck.driverId)?.fullName}</span>
                </div>
                <div className="col-span-2 border-t border-slate-200 mt-2 pt-2 grid grid-cols-2 gap-2 text-[10.5px]">
                  <div>
                    <span className="text-slate-400 block uppercase font-bold tracking-tight text-[9px]">Calculated Duration</span>
                    <span className="font-bold text-slate-800">
                      {Math.floor((viewingCheck.durationSeconds || 0) / 60)}m {(viewingCheck.durationSeconds || 0) % 60}s
                    </span>
                  </div>
                  <div>
                    <span className="text-slate-400 block uppercase font-bold tracking-tight text-[9px]">Configured Minimum Target</span>
                    <span className="font-bold text-slate-800">
                      {(() => {
                        const veh = vehicles.find(v => v.id === viewingCheck.vehicleId);
                        const minVal = veh?.type === 'lgv' ? (company.minDurationLgv !== undefined ? company.minDurationLgv : 5) : veh?.type === 'hgv' ? (company.minDurationHgv !== undefined ? company.minDurationHgv : 10) : (company.minDurationHgvTrailer !== undefined ? company.minDurationHgvTrailer : 15);
                        return minVal;
                      })()}m
                    </span>
                  </div>
                </div>
              </div>

              <div className="col-span-2">
                <span className="font-bold uppercase tracking-wider block text-slate-400 mb-2 font-mono">27 Legal items evaluated result</span>
                
                <div className="grid grid-cols-1 md:grid-cols-2 gap-1.5 font-mono max-h-[300px] overflow-y-auto bg-slate-50 p-3 rounded border border-slate-200 text-[11px]">
                  {viewingCheck.items && viewingCheck.items.map((item, idx) => (
                    <div key={idx} className="flex justify-between py-0.5 border-b border-slate-100">
                      <span className="text-slate-600 truncate max-w-[170px]">{item.itemLabel}</span>
                      <span className={item.result === 'pass' ? 'text-emerald-600 font-bold' : 'text-red-500 font-bold'}>
                        {item.result === 'pass' ? 'PASS' : 'FAIL ✗'}
                      </span>
                    </div>
                  ))}
                </div>
              </div>

              {/* Decryption status */}
              <div className="col-span-2">
                <span className="text-slate-500 inline-block font-sans">Verification: Secure checksum verification: SHA-256 validation verified. Fully compliant.</span>
              </div>

              {/* GPS Geolocation verification */}
              <div className="col-span-2 border-t border-slate-100 pt-3">
                <span className="font-mono font-bold uppercase tracking-wider block text-slate-400 mb-1">GPS Satellite Verification</span>
                {viewingCheck.latitude ? (
                  <div className="flex items-center justify-between text-slate-700 bg-emerald-50/75 border border-emerald-100 p-2.5 rounded-xl font-mono">
                    <span className="flex items-center gap-1.5 text-emerald-800 text-[11px]">
                      <MapPin className="w-3.5 h-3.5 text-emerald-600 shrink-0" />
                      COORDINATES: {viewingCheck.latitude.toFixed(6)}, {viewingCheck.longitude?.toFixed(6)}
                    </span>
                    <a
                      href={`https://www.google.com/maps/search/?api=1&query=${viewingCheck.latitude},${viewingCheck.longitude}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      className="text-[10px] text-amber-600 hover:text-amber-700 font-bold underline flex items-center gap-0.5"
                    >
                      🗺️ Open MAPS
                    </a>
                  </div>
                ) : (
                  <div className="text-slate-400 bg-slate-50 border border-slate-200 p-2.5 rounded-xl font-mono italic text-[11px]">
                    No GPS telemetry available for this legacy manual log.
                  </div>
                )}
              </div>

              {/* Miscellaneous Damage notes and photo */}
              {((viewingCheck.miscDamageNotes && viewingCheck.miscDamageNotes.trim() !== '') || viewingCheck.miscDamagePhotoUrl) && (
                <div className="col-span-2 border-t border-slate-100 pt-3">
                  <span className="font-mono font-bold uppercase tracking-wider block text-slate-400 mb-1">Miscellaneous Damage & Notes</span>
                  <div className="bg-slate-50 border border-slate-200 p-3 rounded-xl font-mono text-slate-700 space-y-2">
                    {viewingCheck.miscDamageNotes && (
                      <div>
                        <span className="text-slate-400 block text-[9px] font-bold uppercase">Driver's Notes:</span>
                        <p className="text-[11.5px] whitespace-pre-wrap leading-relaxed">{viewingCheck.miscDamageNotes}</p>
                      </div>
                    )}
                    {viewingCheck.miscDamagePhotoUrl && (
                      <div>
                        <span className="text-slate-400 block text-[9px] font-bold uppercase">Driver's Photo Evidence:</span>
                        <div className="mt-1 max-w-full rounded-lg overflow-hidden border border-slate-200 bg-white p-1 inline-block">
                          <img 
                            src={viewingCheck.miscDamagePhotoUrl} 
                            alt="Miscellaneous Damage Record" 
                            className="max-h-36 object-contain"
                            referrerPolicy="no-referrer"
                          />
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              )}

              {/* Download PDF widget inside Review card */}
              <button
                onClick={() => { triggerPdfDownload(viewingCheck); setViewingCheck(null); }}
                className="col-span-2 w-full bg-slate-950 text-white font-display font-medium text-sm py-2.5 rounded-lg flex items-center justify-center gap-1 uppercase mt-2 mb-2"
              >
                <Download className="w-4 h-4 text-amber-500" /> Export Compliance PDF Report
              </button>

            </div>
          </div>
        </div>
      )}

      {/* DRIVER QR CODE LOGIN DIALOG MODAL */}
      {qrCodeModalLink && (
        <div className="fixed inset-0 bg-slate-950/70 backdrop-blur-xs flex items-center justify-center z-[110] p-4">
          <div className="bg-white rounded-3xl w-full max-w-sm shadow-2xl overflow-hidden flex flex-col items-center p-6 text-center border border-slate-200">
            <div className="w-full flex justify-between items-center mb-4">
              <span className="font-display font-black text-slate-900 uppercase tracking-wide text-sm">QR login passcode bypass</span>
              <button 
                onClick={() => { setQrCodeModalLink(null); setQrCodeModalDriverName(null); }} 
                className="p-1.5 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-full cursor-pointer flex items-center justify-center border-0 bg-transparent"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <div className="bg-slate-50 p-4 rounded-2xl border border-slate-100 mb-4">
              <span className="text-xs font-bold text-slate-500 block uppercase mb-1 font-mono">Driver Identity</span>
              <h5 className="text-lg font-bold text-slate-950 uppercase font-display">{qrCodeModalDriverName}</h5>
            </div>

            <p className="text-xs text-slate-500 leading-normal mb-6">
              Scan this QR code with any smartphone camera to launch the driver session directly. No login password or manual PIN is required.
            </p>

            {/* High fidelity QR Code generated via qrserver API */}
            <div className="bg-white border-2 border-slate-200 p-4 rounded-3xl shadow-xs mb-6 font-mono text-center">
              <img 
                src={`https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(qrCodeModalLink)}`} 
                alt={`${qrCodeModalDriverName} Scannable QR Login Token`}
                className="w-48 h-48 select-none mx-auto"
                referrerPolicy="no-referrer"
              />
            </div>

            <div className="w-full flex flex-col gap-2">
              <button
                type="button"
                onClick={() => {
                  navigator.clipboard.writeText(qrCodeModalLink);
                  alert("Copied custom connection link to clipboard.");
                }}
                className="w-full py-2.5 px-4 bg-slate-900 hover:bg-slate-800 text-[#F5F5F5] font-semibold text-xs rounded-xl shadow-md transition-colors cursor-pointer border-0"
              >
                Copy Link Rather
              </button>
              <button
                type="button"
                onClick={() => { setQrCodeModalLink(null); setQrCodeModalDriverName(null); }}
                className="w-full py-2.5 px-4 bg-white border border-slate-200 hover:bg-slate-50 text-slate-500 text-xs font-semibold rounded-xl transition-colors cursor-pointer"
              >
                Close QR Code
              </button>
            </div>
          </div>
        </div>
      )}

    </div>
  );
}
