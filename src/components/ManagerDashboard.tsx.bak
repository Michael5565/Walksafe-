function CustomSelect({
  value,
  onChange,
  options,
  placeholder = "Select option..."
}: {
  value: string;
  onChange: (val: string) => void;
  options: { value: string; label: string }[];
  placeholder?: string;
}) {
  const [open, setOpen] = useState(false);
  const containerRef = useRef<HTMLDivElement>(null);
  const selectedOpt = options.find(o => o.value === value);

  useEffect(() => {
    function handleClickOutside(event: MouseEvent) {
      if (containerRef.current && !containerRef.current.contains(event.target as Node)) {
        setOpen(false);
      }
    }
    document.addEventListener("mousedown", handleClickOutside);
    return () => {
      document.removeEventListener("mousedown", handleClickOutside);
    };
  }, []);

  return (
    <div ref={containerRef} className="relative w-full">
      <button
        type="button"
        onClick={() => setOpen(!open)}
        className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-xs font-semibold text-slate-100 shadow-md flex justify-between items-center hover:bg-slate-900 transition-all focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 outline-hidden select-none cursor-pointer"
      >
        <span className="truncate">{selectedOpt ? selectedOpt.label : placeholder}</span>
        <ChevronDown className={`w-3.5 h-3.5 text-slate-400 shrink-0 transition-transform duration-150 ${open ? 'rotate-180' : ''}`} />
      </button>
      
      {open && (
        <div className="absolute left-0 right-0 mt-1.5 bg-slate-900 border border-slate-800 rounded-xl shadow-2xl py-1.5 z-[60] max-h-60 overflow-y-auto">
          {options.map((opt) => (
            <button
              key={opt.value}
              type="button"
              onClick={() => {
                onChange(opt.value);
                setOpen(false);
              }}
              className={`w-full text-left px-3.5 py-2 text-xs transition-colors hover:bg-slate-850 flex items-center justify-between ${
                value === opt.value ? 'bg-amber-500/10 text-amber-400 font-bold' : 'text-slate-300'
              }`}
            >
              <span className="truncate">{opt.label}</span>
              {value === opt.value && <Check className="w-3.5 h-3.5 text-amber-500 shrink-0" />}
            </button>
          ))}
        </div>
      )}
    </div>
  );
}

function DriverPinResetter({ driverId, onReset }: { driverId: string, onReset: (id: string, pin: string) => Promise<boolean> }) {
  const [editing, setEditing] = useState(false);
  const [newPin, setNewPin] = useState("");
  const [saving, setSaving] = useState(false);
  const [success, setSuccess] = useState(false);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (newPin.length !== 4 || isNaN(Number(newPin))) {
      alert("PIN must be exactly 4 digits.");
      return;
    }
    setSaving(true);
    const ok = await onReset(driverId, newPin);
    setSaving(false);
    if (ok) {
      setSuccess(true);
      setNewPin("");
      setTimeout(() => {
        setSuccess(false);
        setEditing(false);
      }, 1500);
    } else {
      alert("Could not update secure PIN. Please retry.");
    }
  };

  if (!editing) {
    return (
      <button
        onClick={() => setEditing(true)}
        className="w-full mt-3 py-1.5 px-3 border border-dashed border-slate-800 text-slate-400 hover:border-amber-500 hover:text-amber-500 rounded-lg text-xs font-mono font-bold flex items-center justify-center gap-1.5 transition-all outline-hidden"
      >
        <Lock className="w-3 h-3 text-amber-500" /> RESET DRIVER PIN
      </button>
    );
  }

  return (
    <form onSubmit={handleSubmit} className="mt-3 p-2.5 bg-slate-950/60 border border-slate-850 rounded-lg flex flex-col gap-1.5">
      <div className="flex justify-between items-center mb-0.5">
        <span className="text-[10px] uppercase font-bold text-slate-400 font-mono">Pin Configuration</span>
        <button 
          type="button" 
          onClick={() => setEditing(false)} 
          className="text-slate-500 hover:text-rose-450 text-[10px] font-bold font-mono px-1"
        >
          Cancel
        </button>
      </div>
      <div className="flex gap-1.5">
        <input
          type="text"
          maxLength={4}
          required
          value={newPin}
          onChange={(e) => setNewPin(e.target.value.replace(/\D/g, ''))}
          placeholder="New PIN"
          className="flex-1 bg-slate-900 border border-slate-800 rounded px-2 py-1 text-white text-xs font-mono font-bold tracking-wider text-center focus:outline-hidden focus:border-amber-500"
        />
        <button
          type="submit"
          disabled={saving}
          className="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-[10px] px-2.5 py-1 rounded select-none font-mono tracking-wide"
        >
          {saving ? '...' : success ? 'UPDATED ✓' : 'SAVE'}
        </button>
      </div>
    </form>
  );
}

function AnnouncementPublisherForm({ onSubmit }: { onSubmit: (data: any) => Promise<void> }) {
  const [title, setTitle] = useState("");
  const [content, setContent] = useState("");
  const [important, setImportant] = useState(false);
  const [submitting, setSubmitting] = useState(false);
  const [done, setDone] = useState(false);

  const handlePublish = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!title || !content) return;
    setSubmitting(true);
    try {
      await onSubmit({ title, content, important });
      setTitle("");
      setContent("");
      setImportant(false);
      setDone(true);
      setTimeout(() => setDone(false), 2000);
    } catch (err) {}
    setSubmitting(false);
  };

  return (
    <form onSubmit={handlePublish} className="flex flex-col gap-2.5 text-xs">
      <span className="text-[11px] font-mono uppercase font-extrabold text-slate-300 block">Create Broadcast Notice</span>
      <input
        type="text"
        required
        placeholder="Announcement Heading (e.g., M25 Delays)"
        value={title}
        onChange={(e) => setTitle(e.target.value)}
        className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-white placeholder-slate-550 focus:outline-hidden focus:border-amber-500"
      />
      <textarea
        required
        rows={2}
        placeholder="Detail text to highlight on mobile devices..."
        value={content}
        onChange={(e) => setContent(e.target.value)}
        className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-white placeholder-slate-550 focus:outline-hidden focus:border-amber-500"
      />
      <div className="flex items-center justify-between gap-2">
        <label className="flex items-center gap-1.5 cursor-pointer text-slate-400 text-[11px]">
          <input
            type="checkbox"
            checked={important}
            onChange={(e) => setImportant(e.target.checked)}
            className="rounded text-amber-500 accent-amber-500"
          />
          🚨 High Importance Warning
        </label>
        <button
          type="submit"
          disabled={submitting}
          className="bg-amber-500 text-slate-950 font-display font-medium text-xs py-2 px-4 rounded-lg hover:bg-amber-600 disabled:opacity-50 transition-colors cursor-pointer"
        >
          {submitting ? 'Broadcasting...' : done ? 'Published ✓' : 'Publish Notice 📢'}
        </button>
      </div>
    </form>
  );
}

function ChecklistSchedulerForm({
  vehicles,
  drivers,
  onSubmit
}: {
  vehicles: Vehicle[];
  drivers: Driver[];
  onSubmit: (data: any) => Promise<void>;
}) {
  const [title, setTitle] = useState("Mandated Weekly Compliance Audit");
  const [vehicleId, setVehicleId] = useState("");
  const [driverId, setDriverId] = useState("");
  const [isRecurring, setIsRecurring] = useState(false);
  const [frequency, setFrequency] = useState<'once' | 'daily' | 'weekly' | 'monthly'>('once');
  const [dayOfWeek, setDayOfWeek] = useState<number>(1);
  const [dayOfMonth, setDayOfMonth] = useState<number>(1);
  const [dueDate, setDueDate] = useState(() => {
    const d = new Date();
    d.setDate(d.getDate() + 1);
    return d.toISOString().split('T')[0];
  });
  const [submitting, setSubmitting] = useState(false);
  const [done, setDone] = useState(false);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!title || !vehicleId) {
      alert("Please choose a target vehicle and checklist title.");
      return;
    }
    setSubmitting(true);
    try {
      await onSubmit({
        title,
        vehicleId,
        dueDate,
        driverId: driverId || undefined,
        frequency: isRecurring ? frequency : "once",
        isRecurring: isRecurring,
        dayOfWeek: isRecurring && frequency === 'weekly' ? new Date(dueDate).getDay() : undefined,
        dayOfMonth: isRecurring && frequency === 'monthly' ? new Date(dueDate).getDate() : undefined
      });
      setTitle("Mandated Weekly Compliance Audit");
      setVehicleId("");
      setDriverId("");
      setIsRecurring(false);
      setFrequency("once");
      setDayOfWeek(1);
      setDayOfMonth(1);
      setDone(true);
      setTimeout(() => setDone(false), 2000);
    } catch (err) {}
    setSubmitting(false);
  };

  return (
    <form onSubmit={handleSubmit} className="flex flex-col gap-3.5 text-xs">
      <span className="text-[11px] font-mono uppercase font-extrabold text-slate-300 block">Plan & Schedule Checklist Tasks</span>
      
      <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div>
          <label className="text-[9px] text-slate-400 font-mono block mb-1">Checklist Audit Title</label>
          <input
            type="text"
            required
            value={title}
            onChange={(e) => setTitle(e.target.value)}
            placeholder="e.g. Weekly Brake Audit"
            className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-white placeholder-slate-650 focus:outline-hidden focus:border-amber-500"
          />
        </div>
        <div>
          <label className="text-[9px] text-slate-400 font-mono block mb-1">Target Vehicle (Asset Code)</label>
          <CustomSelect
            value={vehicleId}
            onChange={(val) => setVehicleId(val)}
            placeholder="-- Choose a vehicle --"
            options={vehicles.map(v => ({ value: v.id, label: `${v.registration} (${v.make})` }))}
          />
        </div>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div>
          <label className="text-[9px] text-slate-400 font-mono block mb-1">Assigned Driver (User Option)</label>
          <CustomSelect
            value={driverId}
            onChange={(val) => setDriverId(val)}
            placeholder="-- Any Driver (Unassigned) --"
            options={drivers.map(d => ({ value: d.id, label: d.fullName }))}
          />
        </div>
        <div>
          <label className="text-[9px] text-slate-400 font-mono block mb-1">Initial Due Date</label>
          <input
            type="date"
            required
            value={dueDate}
            onChange={(e) => setDueDate(e.target.value)}
            className="w-full bg-slate-950 border border-slate-800 p-2.5 rounded-lg font-mono text-[11px] text-white focus:outline-hidden"
          />
        </div>
      </div>

      <div className="flex flex-col md:flex-row gap-4 items-start md:items-center justify-between p-3 bg-slate-950 border border-slate-850 rounded-2xl">
        <label className="flex items-center gap-2 cursor-pointer select-none">
          <input
            type="checkbox"
            checked={isRecurring}
            onChange={(e) => {
              setIsRecurring(e.target.checked);
              if (e.target.checked && frequency === 'once') {
                setFrequency('weekly');
              }
            }}
            className="w-4 h-4 rounded text-amber-500 focus:ring-amber-400 border-slate-800"
          />
          <div>
            <span className="font-bold text-slate-200 text-[11px] block text-left">Create Recurring Schedule</span>
            <span className="text-[9.5px] text-slate-500 font-normal text-left block">Re-queue automatically on frequency period</span>
          </div>
        </label>

        {isRecurring && (
          <div className="flex items-center gap-2 w-full md:w-auto">
            <span className="text-[10px] text-slate-400 font-mono">Frequency:</span>
            <div className="w-32">
              <CustomSelect
                value={frequency}
                onChange={(val) => setFrequency(val as any)}
                options={[
                  { value: 'daily', label: 'Every Day' },
                  { value: 'weekly', label: 'Every Week (7 days)' },
                  { value: 'monthly', label: 'Every Month' }
                ]}
              />
            </div>
          </div>
        )}
      </div>

      <div className="flex justify-end mt-1">
        <button
          type="submit"
          disabled={submitting}
          className="bg-amber-500 text-slate-950 font-display font-medium text-xs py-2 px-5 rounded-xl hover:bg-amber-600 disabled:opacity-50 font-bold cursor-pointer transition-all shadow-md"
        >
          {submitting ? 'Scheduling...' : done ? 'Scheduled Successfully ✓' : 'Create Compliance Schedule 🗓️'}
        </button>
      </div>
    </form>
  );
}

interface ManagerDashboardProps {
  vehicles: Vehicle[];
  drivers: Driver[];
  company: Company;
  checks: WalkaroundCheck[];
  defects: Defect[];
  announcements: Announcement[];
  schedules: ScheduledChecklist[];
  notifications: WalkSafeNotification[];
  onAddVehicle: (veh: any) => Promise<void>;
  onAddDriver: (drv: any) => Promise<void>;
  onUpdateDriver?: (driverId: string, drvPayload: Partial<Driver>) => Promise<void>;
  onDeleteDriver?: (driverId: string) => Promise<void>;
  onUpdateVehicle?: (vehicleId: string, vehPayload: Partial<Vehicle>) => Promise<void>;
  onDeleteVehicle?: (vehicleId: string) => Promise<void>;
  onCloseDefect: (defectId: string, repairLog: any) => Promise<void>;
  onUpdateCompany: (compData: any) => Promise<void>;
  onAddAnnouncement: (ann: any) => Promise<void>;
  onAddSchedule: (sch: any) => Promise<void>;
  onResetDriverPin: (driverId: string, pin: string) => Promise<boolean>;
  onMarkNotificationsAsRead: () => Promise<void>;
  onTriggerRefresh: () => void;
  onLogOutWorkspace?: () => void;
}

export default function ManagerDashboard({
  vehicles,
  drivers,
  company,
  checks,
  defects,
  announcements,
  schedules,
  notifications,
  onAddVehicle,
  onAddDriver,
  onUpdateDriver,
  onDeleteDriver,
  onUpdateVehicle,
  onDeleteVehicle,
  onCloseDefect,
  onUpdateCompany,
  onAddAnnouncement,
  onAddSchedule,
  onResetDriverPin,
  onMarkNotificationsAsRead,
  onTriggerRefresh,
  onLogOutWorkspace
}: ManagerDashboardProps) {
  const [activeTab, setActiveTab] = useState<'overview' | 'operations' | 'vehicles' | 'drivers' | 'defects' | 'records' | 'settings' | 'schedules' | 'billing'>('overview');
  const [scheduleFilter, setScheduleFilter] = useState<'all' | 'pending' | 'completed' | 'overdue'>('all');
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);

  // Search, Filters & Modals
  const [globalSearch, setGlobalSearch] = useState("");
  const [vehicleFilter, setVehicleFilter] = useState("all");
  const [statusFilter, setStatusFilter] = useState("all");

  // Add Vehicle modal state
  const [showVehModal, setShowVehModal] = useState(false);
  const [showSchModal, setShowSchModal] = useState(false);
  const [vehReg, setVehReg] = useState("");
  const [vehMake, setVehMake] = useState("");
  const [vehModel, setVehModel] = useState("");
  const [vehYear, setVehYear] = useState(2021);
  const [vehColour, setVehColour] = useState("White");
  const [vehType, setVehType] = useState<'lgv' | 'hgv' | 'hgv_trailer'>('lgv');
  const [vehMot, setVehMot] = useState("");
  const [vehTax, setVehTax] = useState("");
  const [assignedDriverId, setAssignedDriverId] = useState("");
  const [dvlaLoading, setDvlaLoading] = useState(false);
  const [dvlaSuccess, setDvlaSuccess] = useState(false);
  const [dvlaError, setDvlaError] = useState("");

  // Add Driver modal state
  const [showDrvModal, setShowDrvModal] = useState(false);
  const [editingDriver, setEditingDriver] = useState<Driver | null>(null);
  const [isSavingDriver, setIsSavingDriver] = useState(false);
  const [drvInviteToken, setDrvInviteToken] = useState("");
  const [drvName, setDrvName] = useState("");
  const [drvEmail, setDrvEmail] = useState("");
  const [drvPhone, setDrvPhone] = useState("");
  const [drvPin, setDrvPin] = useState("");
  const [drvDefaultVeh, setDrvDefaultVeh] = useState("");
  const [generatedLink, setGeneratedLink] = useState("");

  // Edit / Add status states for Vehicle
  const [editingVehicle, setEditingVehicle] = useState<Vehicle | null>(null);
  const [isSavingVehicle, setIsSavingVehicle] = useState(false);

  // QR Code Modal popup states
  const [qrCodeModalLink, setQrCodeModalLink] = useState<string | null>(null);
  const [qrCodeModalDriverName, setQrCodeModalDriverName] = useState<string | null>(null);

  // Engineer repair modal state
  const [repairingDefectId, setRepairingDefectId] = useState<string | null>(null);
  const [repairNotes, setRepairNotes] = useState("");
  const [repairParts, setRepairParts] = useState("");
  const [engineerName, setEngineerName] = useState("Dave Briggs (Mechanic)");
  const [engineerSignature, setEngineerSignature] = useState("");

  // Dynamic Web Defect Gallery features & filters (Fleetio / Whip Around visual triage inspired)
  const [defectViewMode, setDefectViewMode] = useState<'list' | 'gallery'>('gallery');
  const [gallerySeverityFilter, setGallerySeverityFilter] = useState<'all' | 'dangerous' | 'major' | 'minor'>('all');
  const [galleryStatusFilter, setGalleryStatusFilter] = useState<'all' | 'open' | 'in_repair' | 'closed'>('all');
  const [selectedGalleryDefect, setSelectedGalleryDefect] = useState<Defect | null>(null);

  // Company settings states
  const [compName, setCompName] = useState(company.name);
  const [compEmail, setCompEmail] = useState(company.email || "");
  const [compPassword, setCompPassword] = useState(company.managerPassword || "");
  const [compLicence, setCompLicence] = useState(company.oLicence || "");
  const [minLgv, setMinLgv] = useState<number>(company.minDurationLgv !== undefined ? company.minDurationLgv : 5);
  const [minHgv, setMinHgv] = useState<number>(company.minDurationHgv !== undefined ? company.minDurationHgv : 10);
  const [minHgvTrailer, setMinHgvTrailer] = useState<number>(company.minDurationHgvTrailer !== undefined ? company.minDurationHgvTrailer : 15);
  const [compSavedMsg, setCompSavedMsg] = useState(false);
  const [compErrorMsg, setCompErrorMsg] = useState("");

  // Push Notification state tracking
  const hasSupport = typeof window !== 'undefined' && 'Notification' in window;
  const [notifPermission, setNotifPermission] = useState<string>(
    hasSupport ? Notification.permission : 'denied'
  );

  const requestPermission = async () => {
    if (!hasSupport) {
      alert("Browser does not support desktop notifications.");
      return;
    }
    const result = await Notification.requestPermission();
    setNotifPermission(result);
    if (result === 'granted') {
      alert("System notifications allowed! To ensure background/off-app reception, please make sure you open the app outside of any preview frame (i.e. 'Open in new tab').");
      
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.ready.then(async (reg) => {
          try {
            const keyRes = await fetch("/api/push/public-key");
            if (keyRes.ok) {
              const { publicKey } = await keyRes.json();
              if (publicKey) {
                const urlBase64ToUint8Array = (base64String: string) => {
                  const padding = '='.repeat((4 - base64String.length % 4) % 4);
                  const base64 = (base64String + padding).replace(/\-/g, '+').replace(/_/g, '/');
                  const rawData = window.atob(base64);
                  const outputArray = new Uint8Array(rawData.length);
                  for (let i = 0; i < rawData.length; ++i) {
                    outputArray[i] = rawData.charCodeAt(i);
                  }
                  return outputArray;
                };
                const sub = await reg.pushManager.subscribe({
                  userVisibleOnly: true,
                  applicationServerKey: urlBase64ToUint8Array(publicKey)
                });
                await fetch("/api/push/register", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({
                    companyId: company.id,
                    subscription: sub
                  })
                });
                alert("Device registered to receive system-wide alerts!");
              }
            }
          } catch (e) {
            console.error("SW manual subscribe error:", e);
          }
        });
      }
    }
  };

  // Detail record modal view
  const [viewingCheck, setViewingCheck] = useState<WalkaroundCheck | null>(null);

  // Sync / Auto Refresh trigger simulation
  const [syncing, setSyncing] = useState(false);

  const handleSyncData = () => {
    setSyncing(true);
    setTimeout(() => {
      onTriggerRefresh();
      setSyncing(false);
    }, 600);
  };

  // Corporate card visual & billing billing states
  const [planSwitching, setPlanSwitching] = useState(false);
  const [calcVehicles, setCalcVehicles] = useState(5);

  // Invoices list computation
  const mockInvoices = [
    { invoiceId: "INV-2026-004", issueDate: "01/06/2026", amount: company.plan === "owner-driver" ? "£4.99" : company.plan === "starter" ? "£14.99" : company.plan === "growth" ? "£34.99" : "£84.99", planName: company.plan === "owner-driver" ? "SOLO" : company.plan === "starter" ? "STARTER" : company.plan === "growth" ? "GROWTH PRO" : "ENTERPRISE", paymentMethod: "4242", status: "PAID" },
    { invoiceId: "INV-2026-003", issueDate: "01/05/2026", amount: company.plan === "owner-driver" ? "£4.99" : "£14.99", planName: company.plan === "owner-driver" ? "SOLO" : "STARTER", paymentMethod: "4242", status: "PAID" },
    { invoiceId: "INV-2026-002", issueDate: "01/04/2026", amount: company.plan === "owner-driver" ? "£4.99" : "£14.99", planName: company.plan === "owner-driver" ? "SOLO" : "STARTER", paymentMethod: "4242", status: "PAID" },
    { invoiceId: "INV-2026-001", issueDate: "01/03/2026", amount: company.plan === "owner-driver" ? "£4.99" : "£14.99", planName: company.plan === "owner-driver" ? "SOLO" : "STARTER (TRIAL)", paymentMethod: "4242", status: "PAID" }
  ];

  const handlePlanUpgrade = async (newPlan: string, maxVehicles: number) => {
    if (newPlan === "enterprise") {
      window.location.href = "mailto:support@getwalksafe.co.uk?subject=WalkSafe%20Enterprise%20Fleet%20Inquiry";
      return;
    }

    setPlanSwitching(true);
    try {
      const response = await fetch("/api/billing/create-checkout-session", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-Company-Id": company.id
        },
        body: JSON.stringify({
          plan: newPlan,
          limit: maxVehicles
        })
      });

      if (!response.ok) {
        const errData = await response.json();
        throw new Error(errData.error || "Failed to create checkout session");
      }

      const data = await response.json();
      if (data.warning) {
        alert(`ℹ️ Notice: ${data.warning}`);
      }
      
      if (data.url) {
        window.location.href = data.url;
      }
    } catch (err: any) {
      alert(`Paystack Connection failed: ${err.message}`);
    } finally {
      setPlanSwitching(false);
    }
  };

  const triggerDownloadInvoice = async (inv: any) => {
    try {
      const { generateInvoicePDF } = await import("../utils/invoiceGenerator");
      const doc = generateInvoicePDF(company, inv);
      doc.save(`WalkSafe_Invoice_${inv.invoiceId}.pdf`);
    } catch (e) {
      alert("Error building client invoice statement.");
    }
  };

  // DVLA Live Lookups
  const handleDvlaLookup = async () => {
    if (!vehReg) {
      setDvlaError("Please enter a valid UK registration number.");
      return;
    }
    setDvlaLoading(true);
    setDvlaError("");
    setDvlaSuccess(false);

    try {
      const response = await fetch(`/api/dvla-lookup/${vehReg.trim().toUpperCase()}`);
      if (!response.ok) {
        const errData = await response.json().catch(() => ({}));
        throw new Error(errData.error || "Could not locate vehicle details in the official DVLA registry.");
      }
      
      const data = await response.json();
      setVehMake(data.make);
      setVehModel(data.model);
      setVehYear(data.year);
      setVehColour(data.colour);
      setVehType(data.type);
      setVehMot(data.motExpiry);
      setVehTax(data.taxExpiry);
      
      setDvlaSuccess(true);
    } catch (err: any) {
      setDvlaError(err.message || "DVLA lookup failed. Enter values manually.");
    } finally {
      setDvlaLoading(false);
    }
  };

  // Saving Vehicle
  const handleSaveVehicle = async (e: React.FormEvent) => {
    e.preventDefault();
    if (isSavingVehicle) return;
    setIsSavingVehicle(true);
    try {
      const payload = {
        registration: vehReg,
        make: vehMake,
        model: vehModel,
        year: vehYear,
        colour: vehColour,
        type: vehType,
        motExpiry: vehMot,
        taxExpiry: vehTax
      };
      if (editingVehicle) {
        if (onUpdateVehicle) {
          await onUpdateVehicle(editingVehicle.id, payload);
        }
      } else {
        if (vehicles.length >= company.vehicleLimit) {
          alert(`Active Plan Limit Reached! Your subscription plan allows a maximum of ${company.vehicleLimit} vehicles. Please go to the "Billing & Licences" tab to upgrade your license tier instantly.`);
          setIsSavingVehicle(false);
          return;
        }
        await onAddVehicle(payload);
      }
      setShowVehModal(false);
      resetVehForm();
    } catch (err) {
      alert("Failed to save. Duplicate registration key detected on database.");
    } finally {
      setIsSavingVehicle(false);
    }
  };

  const resetVehForm = () => {
    setVehReg("");
    setVehMake("");
    setVehModel("");
    setVehYear(2021);
    setVehColour("White");
    setVehType("lgv");
    setVehMot("");
    setVehTax("");
    setDvlaSuccess(false);
    setDvlaError("");
    setEditingVehicle(null);
  };

  // Saving Driver
  const handleSaveDriver = async (e: React.FormEvent) => {
    e.preventDefault();
    if (drvPin.length !== 4) {
      alert("Driver login PIN must be exactly 4-digits.");
      return;
    }
    if (isSavingDriver) return;
    setIsSavingDriver(true);
    try {
      const payload = {
        fullName: drvName,
        email: drvEmail,
        phone: drvPhone,
        pin: drvPin,
        defaultVehicleId: drvDefaultVeh || undefined,
        installToken: drvInviteToken || undefined
      };
      if (editingDriver) {
        if (onUpdateDriver) {
          await onUpdateDriver(editingDriver.id, payload);
        }
      } else {
        await onAddDriver(payload);
      }
      setShowDrvModal(false);
      resetDrvForm();
    } catch (err: any) {
      console.error(err);
      alert(err.message || "Failed to save driver. Possible duplicate email.");
    } finally {
      setIsSavingDriver(false);
    }
  };

  const generateDriverLinkPlaceholder = () => {
    const token = Math.random().toString(36).substr(2, 9);
    setDrvInviteToken(token);
    setGeneratedLink(`https://app.getwalksafe.co.uk/join/${token}`);
  };

  const resetDrvForm = () => {
    setDrvName("");
    setDrvEmail("");
    setDrvPhone("");
    setDrvPin("");
    setDrvDefaultVeh("");
    setDrvInviteToken("");
    setGeneratedLink("");
    setEditingDriver(null);
  };

  // Commit Engineer sign-off & Defect close
  const handleRepairSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!repairingDefectId || !engineerSignature) {
      alert("Engineer compliance signature is required onto the device.");
      return;
    }

    try {
      await onCloseDefect(repairingDefectId, {
        engineerName,
        repairDescription: repairNotes,
        partsUsed: repairParts,
        engineerSignature
      });
      setRepairingDefectId(null);
      setRepairNotes("");
      setRepairParts("");
      setEngineerSignature("");
    } catch (err) {
      console.error(err);
    }
  };

  // Save company changes
  const handleSaveCompany = async (e: React.FormEvent) => {
    e.preventDefault();
    setCompErrorMsg("");
    try {
      await onUpdateCompany({
        name: compName,
        email: compEmail,
        managerPassword: compPassword,
        oLicence: compLicence,
        minDurationLgv: Number(minLgv),
        minDurationHgv: Number(minHgv),
        minDurationHgvTrailer: Number(minHgvTrailer)
      });
      setCompSavedMsg(true);
      setTimeout(() => setCompSavedMsg(false), 2000);
    } catch (err: any) {
      setCompErrorMsg(err.message || "Failed to save settings. Connection error.");
    }
  };

  // Generate compliant PDF download for records list
  const triggerPdfDownload = (check: WalkaroundCheck) => {
    const veh = (vehicles && vehicles.length > 0) ? (vehicles.find(v => v.id === check.vehicleId) || vehicles[0]) : null;
    const drv = (drivers && drivers.length > 0) ? (drivers.find(d => d.id === check.driverId) || drivers[0]) : null;
    const relatedDefs = defects ? defects.filter(df => df.checkId === check.id) : [];
    
    const doc = generateDVSA_PDF(check, veh!, drv!, company, relatedDefs);
    const regLabel = veh ? veh.registration : "UNKNOWN";
    const dateLabel = check ? check.checkDate : new Date().toISOString().split('T')[0];
    doc.save(`WalkSafe_Compliance_${regLabel}_${dateLabel}.pdf`);
  };

  // Core metrics calculators
  const completedToday = checks.filter(c => c.checkDate === new Date().toISOString().split('T')[0]).length;
  const groundedCount = vehicles.filter(v => v.isActive && v.isGrounded).length;
  const activeDefectsCount = defects.filter(d => d.status !== 'closed').length;
  const outstandingChecks = Math.max(0, vehicles.length - completedToday);

  // Compliance scores logic
  // A thorough safety scoring metric independent of daily work check volumes
  const calcComplianceScore = () => {
    let safetyRating = 100;

    // Deduct for active vehicle defects on the list
    const openDefects = defects.filter(d => d.status !== 'closed');
    openDefects.forEach(d => {
      if (d.severity === 'dangerous') safetyRating -= 25;
      else if (d.severity === 'major') safetyRating -= 10;
      else if (d.severity === 'minor') safetyRating -= 5;
    });

    // Deduct for speed check warnings
    const quickCheckWarnings = checks.filter(c => c.quickCheckAlert).length;
    safetyRating -= (quickCheckWarnings * 8);

    // Deduct for expired MOT or tax of active vehicles
    const todayStr = new Date().toISOString().split('T')[0];
    vehicles.forEach(v => {
      if (v.motExpiry < todayStr) safetyRating -= 15;
      if (v.taxExpiry < todayStr) safetyRating -= 15;
    });

    return Math.max(5, Math.min(100, safetyRating));
  };

  const complianceScore = calcComplianceScore();

  // Compute filtered schedules for dedicated scheduling tab
  const filteredSchedules = (schedules || []).filter(s => {
    if (scheduleFilter === 'all') return true;
    return s.status === scheduleFilter;
  });

  return (
    <div className="flex-1 flex flex-col bg-[#0B1120] h-full text-slate-100 font-sans relative overflow-hidden md:pl-60">
      
      {/* Mobile Top Brand Bar */}
      <div className="md:hidden bg-slate-950 text-white py-3 px-4 flex items-center justify-between border-b border-slate-800 sticky top-0 z-30">
        <div className="flex items-center gap-2">
          <div className="p-1 px-1.5 bg-amber-500 rounded text-slate-950">
            <Shield className="w-4 h-4 inline" />
          </div>
          <span className="font-display font-medium text-sm leading-none uppercase tracking-wider text-white">WalkSafe Operator</span>
        </div>
        <button
          onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
          className="p-2 hover:bg-slate-850 rounded-lg text-slate-100 hover:text-white transition-all outline-hidden flex items-center gap-1"
        >
          {mobileMenuOpen ? <X className="w-5 h-5 text-amber-500" /> : <Menu className="w-5 h-5 text-white" />}
        </button>
      </div>

      {/* Mobile Menu Backdrop */}
      {mobileMenuOpen && (
        <div
          onClick={() => setMobileMenuOpen(false)}
          className="fixed inset-0 bg-slate-950/65 z-40 md:hidden transition-opacity duration-200"
        />
      )}

      {/* 1. SIDEBAR NAVIGATION - Desktop (240px wide) & Mobile Overlay Drawer */}
      <div className={`fixed inset-y-0 left-0 bg-slate-900 text-white w-64 md:w-60 shrink-0 flex flex-col justify-between border-r border-slate-800 z-50 transition-transform duration-300 md:translate-x-0 md:top-[61.5px] md:h-[calc(100vh-61.5px)] md:z-20 ${
        mobileMenuOpen ? "translate-x-0" : "-translate-x-full md:translate-x-0"
      }`}>
        <div className="flex flex-col">
          {/* Logo Brand */}
          <div className="px-5 py-6 bg-slate-950 flex items-center justify-between">
            <div className="flex items-center gap-3">
              <div className="p-1.5 bg-amber-500 rounded text-slate-950">
                <Shield className="w-5 h-5" />
              </div>
              <div>
                <h1 className="font-display text-xl font-bold tracking-wider leading-none">WALKSAFE</h1>
                <span className="text-[10px] text-zinc-500 tracking-widest font-mono font-bold">OPERATOR SaaS</span>
              </div>
            </div>
            
            {/* Close button inside sidebar on mobile */}
            <button
              onClick={() => setMobileMenuOpen(false)}
              className="md:hidden p-1 bg-slate-850 rounded-lg text-slate-400 hover:text-white"
            >
              <X className="w-4 h-4" />
            </button>
          </div>

          <div className="p-3 bg-amber-500/5 text-amber-500 text-[11px] font-mono border-y border-amber-500/10 text-center uppercase tracking-wider">
            🚨 DVSA compliance mode
          </div>

          {/* Nav Items list */}
          <nav className="p-4 flex flex-col gap-1.5">
            <button
              onClick={() => { setActiveTab('overview'); setMobileMenuOpen(false); }}
              className={`w-full py-2.5 px-3 rounded-lg flex items-center gap-3 font-medium text-sm transition-colors text-left ${
                activeTab === 'overview' 
                  ? 'bg-amber-500 text-slate-950 font-bold' 
                  : 'text-slate-400 hover:bg-slate-800 hover:text-white'
              }`}
            >
              <FileText className="w-4 h-4" /> Today's Overview
            </button>

            <button
              onClick={() => { setActiveTab('operations'); setMobileMenuOpen(false); }}
              className={`w-full py-2.5 px-3 rounded-lg flex items-center gap-3 font-medium text-sm transition-colors text-left ${
                activeTab === 'operations' 
                  ? 'bg-amber-500 text-slate-950 font-bold' 
                  : 'text-slate-400 hover:bg-slate-800 hover:text-white'
              }`}
            >
              <Settings className="w-4 h-4" /> Operations & Comms
            </button>

            <button
              onClick={() => { setActiveTab('schedules'); setMobileMenuOpen(false); }}
              className={`w-full py-2.5 px-3 rounded-lg flex items-center gap-3 font-medium text-sm transition-colors text-left ${
                activeTab === 'schedules' 
                  ? 'bg-amber-500 text-slate-950 font-bold' 
                  : 'text-slate-400 hover:bg-slate-800 hover:text-white'
              }`}
            >
              <Calendar className="w-4 h-4" /> Compliance Schedules
            </button>

            <button
              onClick={() => { setActiveTab('vehicles'); setMobileMenuOpen(false); }}
              className={`w-full py-2.5 px-3 rounded-lg flex items-center gap-3 font-medium text-sm transition-colors text-left ${
                activeTab === 'vehicles' 
                  ? 'bg-amber-500 text-slate-950 font-bold' 
                  : 'text-slate-400 hover:bg-slate-800 hover:text-white'
              }`}
            >
              <Truck className="w-4 h-4" /> Vehicles List
            </button>

            <button
              onClick={() => { setActiveTab('drivers'); setMobileMenuOpen(false); }}
              className={`w-full py-2.5 px-3 rounded-lg flex items-center gap-3 font-medium text-sm transition-colors text-left ${
                activeTab === 'drivers' 
                  ? 'bg-amber-500 text-slate-950 font-bold' 
                  : 'text-slate-400 hover:bg-slate-800 hover:text-white'
              }`}
            >
              <Users className="w-4 h-4" /> Drivers & PINs
            </button>

            <button
              onClick={() => { setActiveTab('defects'); setMobileMenuOpen(false); }}
              className={`w-full py-2.5 px-3 rounded-lg flex items-center gap-3 font-medium text-sm transition-colors text-left ${
                activeTab === 'defects' 
                  ? 'bg-amber-500 text-slate-950 font-bold' 
                  : 'text-slate-400 hover:bg-slate-800 hover:text-white'
              }`}
            >
              <AlertTriangle className="w-4 h-4" /> Defect Repairs
            </button>

            <button
              onClick={() => { setActiveTab('records'); setMobileMenuOpen(false); }}
              className={`w-full py-2.5 px-3 rounded-lg flex items-center gap-3 font-medium text-sm transition-colors text-left ${
                activeTab === 'records' 
                  ? 'bg-amber-500 text-slate-950 font-bold' 
                  : 'text-slate-400 hover:bg-slate-800 hover:text-white'
              }`}
            >
              <FileText className="w-4 h-4" /> Compliance Log
            </button>

            <button
              onClick={() => { setActiveTab('settings'); setMobileMenuOpen(false); }}
              className={`w-full py-2.5 px-3 rounded-lg flex items-center gap-3 font-medium text-sm transition-colors text-left ${
                activeTab === 'settings' 
                  ? 'bg-amber-500 text-slate-950 font-bold' 
                  : 'text-slate-400 hover:bg-slate-800 hover:text-white'
              }`}
            >
              <Settings className="w-4 h-4" /> Company Profile
            </button>

            <button
              onClick={() => { setActiveTab('billing'); setMobileMenuOpen(false); }}
              className={`w-full py-2.5 px-3 rounded-lg flex items-center gap-3 font-medium text-sm transition-colors text-left ${
                activeTab === 'billing' 
                  ? 'bg-amber-500 text-slate-950 font-bold' 
                  : 'text-slate-400 hover:bg-slate-800 hover:text-white'
              }`}
            >
              <CreditCard className="w-4 h-4 text-emerald-400" /> Billing & Licences
            </button>
          </nav>
        </div>

        {/* Bottom account info details */}
        <div className="p-4 border-t border-slate-800 bg-slate-950 flex flex-col gap-2.5">
          <div className="flex items-center justify-between text-xs font-mono">
            <div>
              <span className="text-slate-400 block font-sans">Active operator</span>
              <span className="text-white font-bold max-w-[130px] block truncate">{company.name}</span>
            </div>
            <span className="text-[10px] uppercase bg-amber-500/10 border border-amber-500/20 text-amber-500 rounded px-1.5 font-bold">
              {company.plan === 'owner-driver' ? 'OWNER-DRIVER' : company.plan === 'starter' ? 'STARTER (TRIAL)' : 'GROWTH (PRO)'}
            </span>
          </div>

          {onLogOutWorkspace && (
            <button
              type="button"
              onClick={onLogOutWorkspace}
              className="w-full bg-red-950/35 border border-red-900 hover:bg-rose-900/40 text-rose-300 hover:text-white text-[10px] font-mono font-bold py-1.5 px-2.5 rounded-xl flex items-center justify-center gap-1.5 transition-all cursor-pointer"
            >
              <LogOut className="w-3 h-3" />
              LOG OUT WORKSPACE
            </button>
          )}
        </div>
      </div>

      {/* 2. MAIN WEB WORKSPACE */}
      <div className="flex-1 flex flex-col overflow-hidden">
        
        {/* Top Header metrics bar */}
        <header className="bg-[#111827]/80 backdrop-blur-md px-6 py-4 border-b border-[#1F2937]/80 flex items-center justify-between shadow-xs z-20 shrink-0">
          <div>
            <h2 className="font-display text-2xl font-black text-white tracking-tight flex items-center gap-2">
              {activeTab === 'overview' && "Compliance Overview Workspace"}
              {activeTab === 'operations' && "Operations & Broadcasting Comms"}
              {activeTab === 'schedules' && "Compliance Audit Scheduling"}
              {activeTab === 'vehicles' && "Fleet Vehicle Registers"}
              {activeTab === 'drivers' && "Drivers Credential Systems"}
              {activeTab === 'defects' && "Defect Triage & Repair Logs"}
              {activeTab === 'records' && "TAMPER-PROOF COMPLIANCE LOGS"}
              {activeTab === 'settings' && "Operator Company Config"}
              {activeTab === 'billing' && "Operator Billing & Subscriptions"}
            </h2>
            <p className="text-xs text-zinc-400 mt-0.5">
              Secure roadworthiness cloud archive reference: <span className="font-mono text-amber-500 font-bold">DVSA-GMR-OM1234567</span>
            </p>
          </div>

          <div className="flex items-center gap-3">
            {/* Clock element */}
            <span className="hidden lg:inline-flex text-xs font-mono font-bold text-zinc-300 bg-slate-900 border border-slate-800 px-3 py-1.5 rounded-lg items-center gap-1">
              <Clock className="w-3.5 h-3.5 text-amber-500 animate-pulse" />
              SYSTEM UTC: {new Date().toLocaleTimeString("en-GB", { hour: '2-digit', minute: '2-digit' })}
            </span>

            <button
              onClick={handleSyncData}
              disabled={syncing}
              className="bg-gradient-to-r from-blue-600 to-indigo-600 text-white hover:from-blue-500 hover:to-indigo-500 text-xs py-2 px-3.5 rounded-lg flex items-center gap-2 font-mono font-bold uppercase transition-all shadow-md shadow-blue-500/15"
            >
              <RefreshCw className={`w-3.5 h-3.5 text-white ${syncing ? 'animate-spin' : ''}`} />
              {syncing ? 'SYNCING...' : 'SYNC REMOTE'}
            </button>
          </div>
        </header>

        {/* Dashboard contents area */}
        <main className="flex-1 p-6 max-w-7xl w-full mx-auto overflow-y-auto">
          
          {/* Grounded Dangerous Defect Banner alert */}
          {groundedCount > 0 && (
            <div className="bg-rose-600 rounded-[28px] p-1 text-white mb-6 shadow-xl shadow-rose-900/10 flex flex-col sm:flex-row items-stretch justify-between overflow-hidden border border-rose-500/30">
              <div className="flex gap-4 items-center p-4 md:p-5 flex-1">
                <div className="p-3 bg-rose-700 rounded-2xl shrink-0 shadow-inner">
                  <AlertOctagon className="w-6 h-6 text-white shrink-0 animate-pulse" />
                </div>
                <div>
                  <h3 className="font-display font-black text-lg md:text-xl leading-tight uppercase tracking-tight">
                    CRITICAL GROUNDED ALERT
                  </h3>
                  <p className="text-[11px] md:text-xs text-rose-100 mt-1 leading-relaxed max-w-lg">
                    {groundedCount} logistics vehicle{groundedCount > 1 ? 's are' : ' is'} grounded due to outstanding red-flag dangerous defects. Driver check-in Restricted until repaired.
                  </p>
                </div>
              </div>
              <button 
                onClick={() => { setActiveTab('defects'); }}
                className="bg-rose-950/20 hover:bg-rose-950/40 border-l border-rose-500/20 backdrop-blur-md px-6 py-4 flex items-center justify-center font-display font-black text-xs shrink-0 uppercase tracking-widest text-white transition-all cursor-pointer group"
              >
                Inspect Defects
                <ArrowRight className="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1" />
              </button>
            </div>
          )}

          {/* TAB 1: OVERVIEW */}
          {activeTab === 'overview' && (
            <div className="flex flex-col gap-6">
              
              {/* Solo Account Mode Informational Notice */}
              {company.plan === 'owner-driver' && (
                <div className="bg-amber-500/10 border border-amber-500/25 p-5 rounded-3xl flex flex-col md:flex-row justify-between items-start md:items-center gap-4 text-left">
                  <div className="space-y-1">
                    <div className="flex items-center gap-2">
                      <span className="bg-amber-500 text-slate-950 text-[10px] uppercase font-mono font-black px-2 py-0.5 rounded-full inline-block">Solo Profile Activated</span>
                      <span className="text-slate-400 text-xs font-semibold">• Single-Asset Owner-Driver license</span>
                    </div>
                    <p className="text-xs text-slate-500 leading-relaxed max-w-2xl">
                      This compliance workspace is designed for individual operators. Interactive broadcasting notice bulletin boards, team driving cards, and automated push alerts are deactivated. Upgrade to unlock full multi-driver setups.
                    </p>
                  </div>
                  <button 
                    onClick={() => setActiveTab('billing')}
                    className="bg-amber-500 hover:bg-amber-600 text-slate-950 font-sans font-extrabold text-xs px-5 py-2.5 rounded-xl transition-all shadow-sm shrink-0 cursor-pointer"
                  >
                    Upgrade Fleet License ⚡
                  </button>
                </div>
              )}

              {/* Stats Counters Grid - More visual & Dashboard-like */}
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                
                {/* 1. Compliance Score Ring - THE MAIN FLEET METER */}
                <div 
                  className="bg-slate-900 rounded-3xl p-6 shadow-xl relative overflow-visible flex flex-col items-center justify-center border border-slate-800 transition-all duration-200 group"
                >
                  <div className="absolute top-3 left-4">
                    <span className="text-[9px] text-amber-500 font-mono font-bold uppercase tracking-widest">Fleet Integrity</span>
                  </div>
                  
                  <div className="relative flex items-center justify-center w-24 h-24 mt-2">
                    <svg className="w-full h-full -rotate-90">
                      <circle cx="48" cy="48" r="42" stroke="#1E293B" strokeWidth="6" fill="transparent" />
                      <circle 
                        cx="48" cy="48" r="42" stroke="#FDB813" strokeWidth="6" fill="transparent" 
                        strokeDasharray="263.8"
                        strokeDashoffset={263.8 - (263.8 * complianceScore) / 100}
                        strokeLinecap="round"
                        className="transition-all duration-1000 ease-out"
                      />
                    </svg>
                    <span className="absolute font-display text-2xl font-black text-white">{complianceScore}%</span>
                  </div>
                  <div className="mt-2 text-center w-full">
                     <span className="text-[10px] text-slate-400 font-medium font-mono uppercase tracking-tight">Fleet Health</span>
                  </div>

                  {/* Hover Details Box */}
                  <div className="absolute top-full left-0 right-0 mt-2 bg-slate-950 border border-slate-800 rounded-2xl p-4 shadow-2xl z-30 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 pointer-events-none group-hover:pointer-events-auto">
                    <div className="text-[10px] text-slate-400 font-mono space-y-2 w-full">
                       <span className="text-amber-500 font-bold block mb-2 uppercase tracking-widest text-[9px]">Audit Breakdown</span>
                       <div className="flex justify-between pb-1 border-b border-slate-800">
                         <span className="text-slate-500">Fleet Coverage:</span>
                         <span className="text-white font-bold">{vehicles.length} Units</span>
                       </div>
                       <div className="flex justify-between pb-1 border-b border-slate-800">
                         <span className="text-slate-500">Active Defects:</span>
                         <span className={defects.filter(d => d.status !== 'closed').length > 0 ? "text-amber-500" : "text-emerald-400"}>
                           {defects.filter(d => d.status !== 'closed').length > 0 
                             ? `-${defects.filter(d => d.status !== 'closed').reduce((acc, curr) => acc + (curr.severity === 'dangerous' ? 25 : curr.severity === 'major' ? 10 : 5), 0)}%` 
                             : "0%"}
                         </span>
                       </div>
                       <div className="flex justify-between pb-1 border-b border-slate-800">
                         <span className="text-slate-500">Speed Alerts:</span>
                         <span className={checks.filter(c => c.quickCheckAlert).length > 0 ? "text-amber-500" : "text-emerald-400"}>
                           {checks.filter(c => c.quickCheckAlert).length > 0 ? `-${checks.filter(c => c.quickCheckAlert).length * 8}%` : "0%"}
                         </span>
                       </div>
                       <div className="text-[8px] text-zinc-500 text-center uppercase tracking-wider pt-2 font-sans block leading-tight">
                         DVSA Standard Live Evaluation
                        </div>
                     </div>
                  </div>
                </div>

                {/* 2. Today's Summary */}
                <div 
                   onClick={() => setActiveTab('records')}
                   className="bg-slate-900/40 rounded-3xl p-6 border border-slate-800 shadow-xl flex flex-col justify-between cursor-pointer hover:border-slate-700 hover:bg-slate-900/60 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
                 >
                   <div>
                     <span className="text-[11px] text-slate-400 uppercase font-bold tracking-wider">Reports Logged Today</span>
                     <h4 className="font-display text-5xl font-extrabold text-white mt-4 tracking-tighter">
                       {completedToday}
                       <span className="text-xl font-sans font-medium text-slate-500 ml-1">/{vehicles.length}</span>
                     </h4>
                   </div>
                   <div className="mt-4 pt-4 border-t border-slate-800/60">
                     <div className="flex justify-between items-center text-xs">
                       <span className="text-slate-400">Outstanding Runs:</span>
                       <span className={`font-bold font-mono ${outstandingChecks > 0 ? 'text-amber-500' : 'text-emerald-400'}`}>
                         {outstandingChecks} Units
                       </span>
                     </div>
                   </div>
                 </div>

                 {/* 3. Defects Triage */}
                 <div 
                   onClick={() => setActiveTab('defects')}
                   className="bg-slate-900/40 rounded-3xl p-6 border border-slate-800 shadow-xl flex flex-col justify-between relative overflow-hidden cursor-pointer hover:border-slate-700 hover:bg-slate-900/60 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
                 >
                   {activeDefectsCount > 0 && <div className="absolute top-0 right-0 p-2"><div className="w-2 h-2 bg-orange-500 rounded-full animate-ping" /></div>}
                   <div>
                     <span className="text-[11px] text-slate-400 uppercase font-bold tracking-wider">Open Defect Triage</span>
                     <h4 className="font-display text-5xl font-extrabold text-white mt-4 tracking-tighter">
                       {activeDefectsCount}
                     </h4>
                   </div>
                   <div className="mt-4 pt-4 border-t border-slate-800/60">
                     <div className="w-full text-left text-xs text-orange-400 font-medium hover:underline flex items-center gap-1">
                        Manage {activeDefectsCount} active repairs →
                     </div>
                   </div>
                 </div>

                 {/* 4. Grounded Fleet */}
                 <div 
                   onClick={() => setActiveTab('vehicles')}
                   className={`rounded-3xl p-6 border shadow-xl flex flex-col justify-between cursor-pointer hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 ${
                     groundedCount > 0 
                       ? 'bg-rose-950/20 border-rose-900/50 hover:border-rose-800' 
                       : 'bg-slate-900/40 border-slate-800 hover:border-slate-700 hover:bg-slate-900/60'
                   }`}
                 >
                   <div>
                     <span className={`text-[11px] uppercase font-bold tracking-wider ${groundedCount > 0 ? 'text-rose-400' : 'text-slate-400'}`}>Fleet Suspension</span>
                     <h4 className={`font-display text-5xl font-extrabold mt-4 tracking-tighter ${groundedCount > 0 ? 'text-rose-500 animate-pulse' : 'text-white'}`}>
                       {groundedCount}
                     </h4>
                   </div>
                   <div className="mt-4 pt-4 border-t border-slate-800/60">
                     <span className={`text-xs font-medium ${groundedCount > 0 ? 'text-rose-300' : 'text-slate-400'}`}>
                       {groundedCount > 0 ? "⛔ DO NOT DRIVE" : "✓ Clean Fleet Status"}
                     </span>
                   </div>
                 </div>

                 {/* 5. Scheduling Shortcut */}
                 <div 
                   onClick={() => setActiveTab('schedules')}
                   className="bg-slate-900/60 rounded-3xl p-6 border border-slate-800 shadow-xl flex flex-col justify-between cursor-pointer hover:bg-slate-900/80 hover:border-slate-700 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 group"
                 >
                   <div>
                     <span className="text-[11px] text-amber-500 uppercase font-extrabold tracking-widest">Audit Scheduler</span>
                     <div className="flex items-center justify-between mt-4">
                       <h4 className="font-display text-4xl font-extrabold text-white tracking-tighter">
                         {schedules.filter(s => s.status === 'pending').length}
                       </h4>
                       <Calendar className="w-8 h-8 text-slate-700 group-hover:text-amber-500 transition-colors" />
                     </div>
                   </div>
                   <div className="mt-4 pt-4 border-t border-slate-800/60">
                     <span className="text-xs font-bold text-amber-500 uppercase tracking-wider flex items-center gap-1">
                       Plan Audits <ArrowRight className="w-3 h-3" />
                      </span>
                    </div>
                  </div>
                 </div>

              {/* Enhanced Detailed Overview - Balancing the "weird space" */}
              <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
                {/* Outstanding Items List */}
                <div className="bg-slate-900/40 border border-slate-800 rounded-3xl p-6 shadow-xl">
                  <div className="flex items-center gap-2 border-b border-slate-800/60 pb-3 mb-6">
                    <Truck className="w-5 h-5 text-slate-400" />
                    <h3 className="font-display text-base font-extrabold text-white uppercase">Today's Outstanding Assets</h3>
                  </div>
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-3 max-h-[300px] overflow-y-auto pr-1">
                    {vehicles.filter(v => !checks.some(c => c.vehicleId === v.id && c.checkDate === new Date().toISOString().split('T')[0])).length === 0 ? (
                      <div className="col-span-full py-16 text-center text-emerald-400 font-medium text-sm flex flex-col items-center gap-3">
                         <CheckCircle className="w-10 h-10 opacity-40 text-emerald-400" />
                         <span className="font-display text-lg font-bold">100% FLEET COMPLIANCE LOGGED</span>
                      </div>
                    ) : (
                      vehicles.filter(v => !checks.some(c => c.vehicleId === v.id && c.checkDate === new Date().toISOString().split('T')[0])).map(v => (
                        <div key={v.id} className="p-3 bg-slate-950/60 border border-slate-850 rounded-xl flex items-center justify-between">
                          <div className="flex items-center gap-3">
                            <span className="uk-plate-yellow text-[10px] py-0.5 px-2 rounded font-bold">{v.registration}</span>
                            <span className="text-[10px] text-slate-300 font-medium uppercase truncate max-w-[80px]">{v.make}</span>
                          </div>
                          <span className="text-[8px] text-amber-500 font-black bg-amber-500/10 px-1.5 py-0.5 rounded border border-amber-500/20 tracking-widest uppercase">PENDING</span>
                        </div>
                      ))
                    )}
                  </div>
                </div>

                {/* Compliance Health Breakdown */}
                <div className="bg-slate-900/40 border border-slate-800 rounded-3xl p-6 shadow-xl">
                  <div className="flex items-center gap-2 border-b border-slate-800/60 pb-3 mb-6">
                    <ShieldCheck className="w-5 h-5 text-slate-400" />
                    <h3 className="font-display text-base font-extrabold text-white uppercase">Compliance Health Breakdown</h3>
                  </div>
                  <div className="space-y-4">
                    <div className="p-4 bg-slate-950/60 rounded-2xl border border-slate-850 flex justify-between items-center">
                      <div className="flex flex-col text-left">
                        <span className="text-sm font-bold text-white">Fleet Evaluation Coverage</span>
                        <span className="text-[10px] text-slate-450 uppercase font-mono">Live evaluation of all {vehicles.length} assets</span>
                      </div>
                      <span className="text-lg font-black text-white">{(vehicles.length - outstandingChecks)} / {vehicles.length}</span>
                    </div>
                    
                    <div className="p-4 bg-slate-950/60 rounded-2xl border border-slate-850 flex justify-between items-center shadow-lg">
                      <div className="flex flex-col text-left">
                        <span className="text-sm font-bold text-slate-200">Safety Deduction Weight</span>
                        <span className="text-[10px] text-slate-450 uppercase font-mono">Real-time defect impact</span>
                      </div>
                      <span className="text-lg font-black text-amber-500">
                        -{100 - complianceScore}%
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* TAB 2: OPERATIONS & COMMS */}
          {activeTab === 'operations' && (
            <div className="flex flex-col gap-6">
              <div className="bg-white p-6 border border-slate-200 rounded-3xl shadow-xs">
                <h3 className="font-display text-xl font-bold text-slate-950">FLEET LOGISTICS & OPERATIONS JOURNAL</h3>
                <p className="text-xs text-slate-500 mt-1">Manage broadcasts and live communication streams across the driver mobile network.</p>
              </div>
              
              {company.plan === 'owner-driver' ? (
                <div className="bg-slate-900 border border-slate-800 rounded-3xl p-8 text-center max-w-2xl mx-auto space-y-5 my-6 font-sans">
                  <div className="mx-auto w-12 h-12 bg-amber-500/10 text-amber-500 rounded-2xl flex items-center justify-center">
                    <Lock className="w-5 h-5" />
                  </div>
                  <div>
                    <h4 className="font-display font-extrabold text-[#F9FAFB] text-sm uppercase tracking-wider">Broadcasting locked on Owner-Driver plan</h4>
                    <p className="text-zinc-400 text-xs mt-2 leading-relaxed">
                      Real-time dispatcher notices, high-priority road warnings, and active notice boards are premium features exclusive to multi-driver subscription tiers. Upgrade your workspace to unlock instantly.
                    </p>
                  </div>
                  <div className="pt-2">
                    <button 
                      onClick={() => setActiveTab('billing')}
                      className="bg-amber-500 hover:bg-amber-600 font-sans font-bold text-slate-950 text-xs px-5 py-2.5 rounded-xl transition-all shadow-sm shrink-0 cursor-pointer"
                    >
                      Upgrade Active Plan ⚡
                    </button>
                  </div>
                </div>
              ) : (
                <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
                  {/* Comms Publisher */}
                  <div className="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm flex flex-col">
                    <div className="flex items-center gap-2 border-b border-slate-100 pb-4 mb-6">
                      <div className="p-1.5 bg-indigo-50 text-indigo-600 rounded-lg">
                        <Menu className="w-4 h-4" />
                      </div>
                      <h3 className="font-display text-base font-extrabold text-slate-900">Broadcast Notice Engine</h3>
                    </div>
                    <AnnouncementPublisherForm onSubmit={onAddAnnouncement} />
                  </div>

                  {/* Live History Ledger */}
                  <div className="bg-slate-900 rounded-3xl p-6 shadow-xl flex flex-col border border-slate-800 h-full">
                    <div className="flex items-center gap-2 border-b border-slate-800 pb-4 mb-6">
                      <div className="p-1.5 bg-amber-500 text-slate-900 rounded-lg">
                        <FileText className="w-4 h-4" />
                      </div>
                      <h3 className="font-display text-base font-extrabold text-white">Broadcast History Journal</h3>
                    </div>
                    <div className="space-y-3 overflow-y-auto pr-1 text-xs">
                      {announcements.length === 0 ? (
                        <div className="text-center py-20 text-slate-600 font-mono italic">Historical ledger empty.</div>
                      ) : (
                        announcements.map(ann => (
                          <div key={ann.id} className={`p-4 rounded-2xl border ${ann.important ? 'bg-red-950/30 border-red-900/50 text-red-100' : 'bg-slate-850 border-slate-800 text-slate-300'}`}>
                            <div className="flex justify-between items-start mb-1">
                              <span className="font-bold text-sm tracking-tight">{ann.title}</span>
                              <span className="text-[10px] text-slate-500 font-mono">{new Date(ann.createdAt).toLocaleDateString("en-GB")}</span>
                            </div>
                            <p className="opacity-80 leading-relaxed">{ann.content}</p>
                            {ann.important && <span className="mt-2 inline-block bg-red-600 text-white text-[9px] font-black px-1.5 py-0.5 rounded uppercase tracking-widest">Critical Alert</span>}
                          </div>
                        ))
                      )}
                    </div>
                  </div>
                </div>
              )}
            </div>
          )}
          {activeTab === 'schedules' && (
            <div className="flex flex-col gap-6">
              <div className="bg-white p-6 border border-slate-200 rounded-3xl shadow-xs flex flex-col md:flex-row justify-between items-center gap-4">
                <div>
                  <h3 className="font-display text-xl font-bold text-slate-950 uppercase tracking-tight">Compliance Audit Workspace</h3>
                  <p className="text-xs text-slate-500 mt-1 block">Plan and manage mandated roadworthiness inspections for all logistics assets.</p>
                </div>
                <div className="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
                  <div className="flex bg-slate-100 p-1 rounded-xl w-full sm:w-auto">
                    {(['all', 'pending', 'completed', 'overdue'] as const).map(f => (
                      <button
                        key={f}
                        onClick={() => setScheduleFilter(f)}
                        className={`flex-1 md:flex-none md:w-24 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-wider transition-all ${
                          scheduleFilter === f 
                            ? 'bg-white text-slate-950 shadow-sm' 
                            : 'text-slate-500 hover:text-slate-700'
                        }`}
                      >
                        {f}
                      </button>
                    ))}
                  </div>
                  <button
                    onClick={() => setShowSchModal(true)}
                    className="w-full sm:w-auto bg-amber-500 text-slate-950 px-5 py-2.5 rounded-xl font-display font-black text-xs shadow-md hover:bg-amber-600 transition-all flex items-center justify-center gap-2"
                  >
                    <Plus className="w-4 h-4" /> CREATE SCHEDULE
                  </button>
                </div>
              </div>

              <div className="grid grid-cols-1 lg:grid-cols-1 gap-6 items-start">
                {/* 1. Schedule Ledger Area */}
                <div className="flex flex-col gap-4">
                  <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    {filteredSchedules.length === 0 ? (
                      <div className="col-span-full py-24 text-center bg-white border border-slate-200 rounded-3xl text-slate-300 font-mono text-xs italic">
                        No audit schedules found for the active workspace filter.
                      </div>
                    ) : (
                      filteredSchedules.map(sch => {
                        const veh = vehicles.find(v => v.id === sch.vehicleId);
                        return (
                          <div key={sch.id} className="bg-white rounded-3xl border border-slate-200 p-5 shadow-xs hover:border-amber-300 transition-all flex flex-col justify-between">
                            <div>
                              <div className="flex justify-between items-start mb-3">
                                <h4 className="font-bold text-slate-900 text-sm">{sch.title}</h4>
                                <span className={`px-2 py-0.5 rounded text-[9px] font-black uppercase font-mono tracking-wider ${
                                  sch.status === 'completed' ? 'bg-emerald-100 text-emerald-800' : 
                                  sch.status === 'overdue' ? 'bg-rose-100 text-rose-800' : 'bg-amber-100 text-amber-700'
                                }`}>
                                  {sch.status}
                                </span>
                              </div>
                              <div className="space-y-2 mb-4 text-xs">
                                <div className="flex items-center gap-2 text-slate-600">
                                  <Truck className="w-3.5 h-3.5 text-slate-400" />
                                  <span className="font-mono font-bold leading-none">{veh?.registration || "Unknown"}</span>
                                  <span className="opacity-60 leading-none">{veh?.make}</span>
                                </div>
                                <div className="flex items-center gap-2 text-slate-600">
                                  <Calendar className="w-3.5 h-3.5 text-amber-500" />
                                  <span className="font-bold">Due Date: {sch.dueDate}</span>
                                </div>
                              </div>
                            </div>
                            <div className="pt-3 border-t border-slate-50 flex items-center justify-between text-[10px] text-slate-400">
                              <div className="flex gap-1.5 items-center">
                                {sch.isRecurring && <span className="bg-slate-50 border border-slate-100 px-1.5 py-0.5 rounded uppercase font-mono font-bold text-amber-600">🔁 Recurring</span>}
                              </div>
                              <div className="flex items-center gap-3">
                                <span className="font-mono">Audit#{sch.id.split('-')[1]}</span>
                                <button
                                  onClick={async () => {
                                    if (confirm("Proceed to delete this audit schedule? All history for this specific audit loop will be cleared.")) {
                                      const res = await fetch(`/api/schedules/${sch.id}`, {
                                        method: "DELETE",
                                        headers: {
                                          "x-company-id": company.id
                                        }
                                      });
                                      if (res.ok) {
                                        onTriggerRefresh();
                                      } else {
                                        alert("Failed to delete schedule.");
                                      }
                                    }
                                  }}
                                  className="p-1 text-slate-300 hover:text-rose-500 transition-colors cursor-pointer"
                                  title="Delete Schedule"
                                >
                                  <Trash2 className="w-3.5 h-3.5" />
                                </button>
                              </div>
                            </div>
                          </div>
                        );
                      })
                    )}
                  </div>

                  {/* 2. Signals / Notifications Ledger */}
                  <div className="bg-white border border-slate-200 rounded-3xl p-6 shadow-xs mt-2">
                    <div className="flex items-center gap-2 border-b border-slate-100 pb-3 mb-4">
                      <div className="p-1.5 bg-amber-50 text-amber-600 rounded-lg font-mono font-bold">🔔</div>
                      <h3 className="font-display text-base font-extrabold text-slate-900 uppercase">Compliance Signal Stream</h3>
                    </div>
                    <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                      {notifications.length === 0 ? (
                        <div className="col-span-full text-center py-10 text-slate-300 font-mono text-xs italic">No passive signals recorded.</div>
                      ) : (
                        notifications.map(not => (
                          <div key={not.id} className={`p-3 rounded-2xl border ${!not.isRead ? 'bg-amber-50 border-amber-300 text-slate-900' : 'bg-slate-50 border-slate-100 text-slate-500'}`}>
                            <div className="flex justify-between gap-1">
                              <span className="font-bold text-[11px] tracking-tight">{not.title}</span>
                              <span className="text-[9px] opacity-60 uppercase">{new Date(not.createdAt).toLocaleTimeString("en-GB", { hour:'2-digit', minute:'2-digit' })}</span>
                            </div>
                            <p className="text-[10px] mt-1 leading-tight">{not.message}</p>
                          </div>
                        ))
                      )}
                    </div>
                    <div className="mt-4 pt-4 border-t border-slate-100 text-right">
                       <button onClick={onMarkNotificationsAsRead} className="px-5 py-2 bg-slate-900 hover:bg-slate-800 text-white font-mono text-[10px] uppercase font-bold rounded-xl transition-all cursor-pointer">Acknowledge Unread Badges ✓</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* TAB 2: VEHICLES */}
          {activeTab === 'vehicles' && (
            <div className="flex flex-col gap-5">
              <div className="flex justify-between items-center bg-white p-4 border border-slate-200 rounded-2xl shadow-xs">
                <div>
                  <h3 className="font-display text-lg font-bold text-slate-950">COGNIZABLE SHIFT REGISTERS</h3>
                  <p className="text-xs text-slate-500 mt-0.5">Management details of your {vehicles.length} assets</p>
                </div>

                <button
                  onClick={() => setShowVehModal(true)}
                  className="bg-amber-500 text-slate-950 hover:bg-amber-600 font-display font-medium text-sm py-2 px-4 rounded-xl flex items-center gap-1.5 shadow-sm"
                >
                  <Plus className="w-4 h-4 text-slate-950" /> Add Vehicle
                </button>
              </div>

              {/* Vehicle Card grid */}
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {vehicles.map(v => (
                  <div key={v.id} className="bg-white border border-slate-200 rounded-3xl p-6 shadow-xs flex flex-col justify-between min-h-[220px] transition-all hover:shadow-md hover:border-slate-300">
                    <div>
                      {/* Flex row to display make/model on the left, registration on the right */}
                      <div className="flex justify-between items-start gap-3 mb-4">
                        <div className="flex-1 min-w-0">
                          <span className="text-[9px] uppercase font-mono tracking-wider font-bold text-slate-400 block mb-1">
                            {v.type === 'lgv' ? 'Rigid Van (LGV)' : v.type === 'hgv' ? 'HGV Rigid Box' : 'Articulated Cab + Trailer'}
                          </span>
                          <h4 className="font-display text-lg font-bold text-slate-900 uppercase leading-snug truncate">
                            {v.make} {v.model}
                          </h4>
                          <p className="text-xs text-slate-500 font-medium mt-0.5">Year: {v.year} • Color: {v.colour}</p>
                        </div>
                        <div className="shrink-0">
                          <span className="inline-block bg-[#FDB813] text-slate-950 font-mono font-bold text-[11px] px-2.5 py-1 rounded-md border border-neutral-900 tracking-wider shadow-xs leading-none uppercase select-none">
                            {v.registration}
                          </span>
                        </div>
                      </div>
                    </div>

                    <div className="border-t border-slate-100 pt-4 mt-auto">
                      <div className="grid grid-cols-2 gap-3 mb-4 text-xs">
                        <div>
                          <span className="text-slate-400 text-[9px] uppercase font-mono tracking-wider block mb-0.5">MOT Due Expiry</span>
                          <span className="font-mono font-bold text-slate-755 block">{v.motExpiry}</span>
                        </div>
                        <div>
                          <span className="text-slate-400 text-[9px] uppercase font-mono tracking-wider block mb-0.5">Tax Status Expires</span>
                          <span className="font-mono font-bold text-slate-755 block">{v.taxExpiry}</span>
                        </div>
                      </div>

                      <div className="flex gap-2 text-xs mb-3">
                        {v.isGrounded ? (
                          <div className="w-full py-2 px-3 text-center font-bold bg-red-50 text-red-600 rounded-xl border border-red-100 flex items-center justify-center gap-1.5 leading-none">
                            <span className="w-2 h-2 rounded-full bg-red-600 animate-pulse inline-block" />
                            ⛔ VEHICLE GROUNDED
                          </div>
                        ) : (
                          <div className="w-full py-2 px-3 text-center font-bold bg-emerald-50 text-emerald-600 rounded-xl border border-emerald-100 flex items-center justify-center gap-1.5 leading-none">
                            <span className="w-2 h-2 rounded-full bg-emerald-500 inline-block" />
                            ✓ ACTIVE SAFETY ROADWORTHY
                          </div>
                        )}
                      </div>

                      {/* Bidirectional Assign Drivers options */}
                      <div className="mt-3 pt-3 border-t border-slate-100">
                        <span className="text-[10px] font-mono font-bold text-slate-400 uppercase tracking-wider block mb-1.5">Assigned Drivers:</span>
                        <div className="flex flex-wrap gap-1">
                          {drivers.map(d => {
                            const isAssigned = d.assignedVehicleIds?.includes(v.id) || d.defaultVehicleId === v.id;
                            return (
                              <button
                                key={d.id}
                                type="button"
                                onClick={() => {
                                  if (onUpdateDriver) {
                                    const currentIds = d.assignedVehicleIds || [];
                                    const nextIds = isAssigned
                                      ? currentIds.filter(id => id !== v.id)
                                      : [...currentIds, v.id];
                                    onUpdateDriver(d.id, { assignedVehicleIds: nextIds });
                                  }
                                }}
                                className={`text-[9px] font-semibold px-2 py-1 rounded-lg border transition-all cursor-pointer ${
                                  isAssigned
                                    ? "bg-amber-500/10 border-amber-300 text-amber-700 hover:bg-amber-500/20"
                                    : "bg-slate-50 border-slate-200 text-slate-400 hover:bg-slate-100 hover:text-slate-600"
                                }`}
                              >
                                {d.fullName} {isAssigned ? "✓" : "+"}
                              </button>
                            );
                          })}
                        </div>
                      </div>

                      {/* Edit and Delete buttons for vehicle */}
                      <div className="flex gap-2 mt-4 pt-3 border-t border-slate-100">
                        <button
                          type="button"
                          onClick={() => {
                            setEditingVehicle(v);
                            setVehReg(v.registration);
                            setVehMake(v.make);
                            setVehModel(v.model);
                            setVehYear(v.year);
                            setVehColour(v.colour);
                            setVehType(v.type);
                            setVehMot(v.motExpiry);
                            setVehTax(v.taxExpiry);
                            setShowVehModal(true);
                          }}
                          className="flex-1 py-1.5 px-3 bg-white border border-slate-200 hover:bg-slate-50 text-slate-600 rounded-xl text-xs font-semibold cursor-pointer text-center flex items-center justify-center gap-1"
                        >
                          Edit Vehicle
                        </button>
                        <button
                          type="button"
                          onClick={() => {
                            if (onDeleteVehicle) {
                              onDeleteVehicle(v.id);
                            }
                          }}
                          className="flex-shrink-0 p-1.5 border border-red-200 hover:bg-red-50 text-red-600 rounded-xl cursor-pointer flex items-center justify-center"
                          title="Delete Vehicle"
                        >
                          <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* TAB 3: DRIVERS */}
          {activeTab === 'drivers' && (
            <div className="flex flex-col gap-5">
              {company.plan === 'owner-driver' ? (
                <div className="bg-slate-900 border border-slate-800 rounded-3xl p-8 text-center max-w-2xl mx-auto space-y-5 my-6 font-sans">
                  <div className="mx-auto w-12 h-12 bg-amber-500/10 text-amber-500 rounded-2xl flex items-center justify-center">
                    <Lock className="w-5 h-5" />
                  </div>
                  <div>
                    <h4 className="font-display font-extrabold text-[#F9FAFB] text-sm uppercase tracking-wider">Multi-Driver Accounts Locked (Owner-Driver)</h4>
                    <p className="text-zinc-400 text-xs mt-2 leading-relaxed">
                      You are categorized as a Solo Owner-Driver. This workspace is locked to your main profile credentials. To add additional fleet drivers, distribute secure individual PIN logins, and manage driver cards, upgrade to the Starter or Growth Fleet membership.
                    </p>
                  </div>
                  <div className="pt-2">
                    <button 
                      onClick={() => setActiveTab('billing')}
                      className="bg-amber-500 hover:bg-amber-600 font-sans font-bold text-slate-950 text-xs px-5 py-2.5 rounded-xl transition-all shadow-sm shrink-0 cursor-pointer"
                    >
                      Upgrade Active Plan ⚡
                    </button>
                  </div>
                </div>
              ) : (
                <>
                  <div className="flex justify-between items-center bg-white p-4 border border-slate-200 rounded-2xl shadow-xs">
                    <div>
                      <h3 className="font-display text-lg font-bold text-slate-950">DRIVERS COMPLIANCE ROLES</h3>
                      <p className="text-xs text-slate-500 mt-0.5 block">Access security credentials for your drivers roster</p>
                    </div>

                    <button
                      onClick={() => setShowDrvModal(true)}
                      className="bg-amber-500 text-slate-950 hover:bg-amber-600 font-display font-medium text-sm py-2 px-4 rounded-xl flex items-center gap-1.5 shadow-sm"
                    >
                      <Plus className="w-4 h-4 text-slate-950" /> Add Driver Card
                    </button>
                  </div>

                  {/* Drivers cards grid */}
                  <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {drivers.map(d => {
                  const dVeh = vehicles.find(v => v.id === d.defaultVehicleId);
                  const driverChecksCount = checks.filter(c => c.driverId === d.id).length;
                  return (
                    <div key={d.id} className="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs flex flex-col justify-between min-h-[190px]">
                      <div>
                        <div className="flex items-center gap-2.5">
                          <div className="p-2 bg-slate-100 text-slate-700 rounded-lg">
                            <Users className="w-5 h-5" />
                          </div>
                          <div>
                            <h4 className="font-display text-lg font-bold text-slate-900 uppercase">{d.fullName}</h4>
                            <div className="flex flex-col gap-0.5">
                              <span className="text-[10px] text-slate-400 font-mono block">Work Email: <strong className="text-slate-600 font-bold">{d.email || "N/A"}</strong></span>
                              <span className="text-[10px] text-slate-400 font-mono block">Operator PIN Code: <strong className="text-amber-500 tracking-wider font-bold">{d.pin}</strong></span>
                            </div>
                          </div>
                        </div>

                        <div className="my-4 border-t border-slate-100 pt-3 text-xs text-slate-600 flex flex-col gap-1.5">
                          <div className="flex justify-between">
                            <span className="text-slate-400">Default Vehicle:</span>
                            <span className="font-bold text-slate-850 font-mono">{dVeh ? dVeh.registration : "None assigned"}</span>
                          </div>
                          <div className="flex justify-between">
                            <span className="text-slate-400">Total checked walks:</span>
                            <span className="font-mono text-slate-750 font-semibold">{driverChecksCount} logs saved</span>
                          </div>
                          <div className="flex justify-between">
                            <span className="text-slate-400">Phone link:</span>
                            <span className="text-[11px] truncate text-slate-500 max-w-[150px]">{d.phone || "Not set"}</span>
                          </div>
                        </div>

                        {/* Interactive assign vehicles link / pill checkboxes */}
                        <div className="mb-4 pt-3 border-t border-slate-100">
                          <span className="text-[10px] font-mono font-bold text-slate-400 uppercase tracking-wider block mb-1.5">Allowed Vehicle Options:</span>
                          <div className="flex flex-wrap gap-1">
                            {vehicles.map(v => {
                              const isAssigned = d.assignedVehicleIds?.includes(v.id) || d.defaultVehicleId === v.id;
                              return (
                                <button
                                  key={v.id}
                                  type="button"
                                  onClick={() => {
                                    if (onUpdateDriver) {
                                      const currentIds = d.assignedVehicleIds || [];
                                      const nextIds = isAssigned
                                        ? currentIds.filter(id => id !== v.id)
                                        : [...currentIds, v.id];
                                      onUpdateDriver(d.id, { assignedVehicleIds: nextIds });
                                    }
                                  }}
                                  className={`text-[9.5px] font-semibold font-mono px-2 py-0.5 rounded-lg border transition-all cursor-pointer ${
                                    isAssigned
                                      ? "bg-amber-500/10 border-amber-300 text-amber-700 hover:bg-amber-500/20"
                                      : "bg-slate-50 border-slate-200 text-slate-400 hover:bg-slate-100 hover:text-slate-600"
                                  }`}
                                >
                                  {v.registration} {isAssigned ? "✓" : "+"}
                                </button>
                              );
                            })}
                          </div>
                        </div>
                      </div>

                      {/* Driver actions & magic invitation links */}
                      <div className="bg-slate-50 rounded-xl border border-slate-200/60 p-3 mb-2 flex flex-col gap-2">
                        <div className="flex justify-between items-center text-[10px] font-mono">
                          <span className="text-slate-400 uppercase font-bold">Magic Access Token:</span>
                          <span className="text-emerald-600 font-bold bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200">{d.installToken || "No token"}</span>
                        </div>
                        
                        <div className="flex gap-2">
                          <button
                            type="button"
                            onClick={() => {
                              const token = d.installToken || "token-" + Math.random().toString(36).substr(2, 9);
                              const host = window.location.origin;
                              const fullLink = `${host}/?join=${token}`;
                              navigator.clipboard.writeText(fullLink);
                              alert("Copied Magic Login Link to Clipboard! Send this directly to the driver's phone:\n\n" + fullLink);
                            }}
                            className="flex-1 py-1 px-2 text-[10px] bg-white border border-slate-300 font-semibold text-slate-700 hover:bg-slate-100 rounded-lg shadow-xs cursor-pointer flex items-center justify-center gap-1"
                            title="Copy Magic Connection URL"
                          >
                            Copy Link
                          </button>
                          
                          <button
                            type="button"
                            onClick={() => {
                              const token = d.installToken || "token-" + Math.random().toString(36).substr(2, 9);
                              const host = window.location.origin;
                              const fullLink = `${host}/?join=${token}`;
                              setQrCodeModalLink(fullLink);
                              setQrCodeModalDriverName(d.fullName);
                            }}
                            className="flex-1 py-1 px-2 text-[10px] bg-amber-500 text-slate-900 font-semibold hover:bg-amber-600 rounded-lg shadow-xs cursor-pointer flex items-center justify-center gap-1"
                            title="Generate a scannable QR Login code"
                          >
                            QR Code Login
                          </button>
                        </div>
                      </div>

                      <div className="flex gap-2 mb-2">
                        <button
                          type="button"
                          onClick={() => {
                            setEditingDriver(d);
                            setDrvName(d.fullName);
                            setDrvEmail(d.email || "");
                            setDrvPhone(d.phone || "");
                            setDrvPin(d.pin);
                            setDrvDefaultVeh(d.defaultVehicleId || "");
                            setDrvInviteToken(d.installToken || "");
                            setGeneratedLink(d.installToken ? `https://app.getwalksafe.co.uk/join/${d.installToken}` : "");
                            setShowDrvModal(true);
                          }}
                          className="flex-1 py-1.5 px-3 bg-white border border-slate-200 hover:bg-slate-50 text-slate-600 rounded-xl text-xs font-semibold cursor-pointer text-center flex items-center justify-center gap-1"
                        >
                          Edit Profile
                        </button>
                        <button
                          type="button"
                          onClick={() => {
                            if (onDeleteDriver) {
                              onDeleteDriver(d.id);
                            }
                          }}
                          className="flex-shrink-0 p-1.5 border border-red-200 hover:bg-red-50 text-red-600 rounded-xl cursor-pointer flex items-center justify-center"
                          title="Delete Driver"
                        >
                          <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                        </button>
                      </div>

                      <DriverPinResetter driverId={d.id} onReset={onResetDriverPin} />
                    </div>
                  );
                })}
              </div>
            </>
          )}
            </div>
          )}

          {/* TAB 4: DEFECTS */}
          {activeTab === 'defects' && (
            <div className="flex flex-col gap-6 animate-fade-in">
              
              {/* Alert compliance notice */}
              <div className="bg-[#111827] p-5 border border-[#1F2937] rounded-3xl shadow-lg relative overflow-hidden">
                <div className="absolute top-0 right-0 w-32 h-32 bg-indigo-500/5 rounded-full blur-2xl" />
                <h3 className="font-display text-lg font-black text-white uppercase tracking-tight">DEFECT VERIFICATION SYSTEM</h3>
                <p className="text-xs text-zinc-400 mt-1 block">Review driver-captured damage photographs & sign-off repair certs with secure electronic engineer signatures.</p>
              </div>

              {/* View toggle & Filters Header panel */}
              <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-[#111827] p-5 rounded-3xl border border-[#1F2937] shadow-xl">
                <div className="flex items-center gap-3">
                  <span className="text-[10px] font-mono font-bold uppercase tracking-wider text-zinc-400">Layout Preset:</span>
                  <div className="inline-flex rounded-xl bg-black/60 p-1 border border-[#1F2937]">
                    <button
                      type="button"
                      onClick={() => setDefectViewMode('gallery')}
                      className={`px-4 py-2 rounded-lg text-[10px] font-display font-black uppercase tracking-widest transition-all duration-300 ${
                        defectViewMode === 'gallery'
                          ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-md shadow-blue-500/15'
                          : 'text-zinc-400 hover:text-white'
                      }`}
                    >
                      📷 Gallery Mode
                    </button>
                    <button
                      type="button"
                      onClick={() => setDefectViewMode('list')}
                      className={`px-4 py-2 rounded-lg text-[10px] font-display font-black uppercase tracking-widest transition-all duration-300 ${
                        defectViewMode === 'list'
                          ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-md shadow-blue-500/15'
                          : 'text-zinc-400 hover:text-white'
                      }`}
                    >
                      📝 Standard List
                    </button>
                  </div>
                </div>

                <div className="flex flex-wrap items-center gap-4">
                  <div className="flex items-center gap-2">
                    <span className="text-[10px] font-mono text-zinc-400 uppercase tracking-widest">Severity:</span>
                    <select
                      value={gallerySeverityFilter}
                      onChange={(e: any) => setGallerySeverityFilter(e.target.value)}
                      className="bg-black/40 border border-[#1F2937] text-xs font-semibold text-white rounded-xl px-3.5 py-2 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500/20"
                    >
                      <option value="all">All Severities</option>
                      <option value="dangerous">🔴 Dangerous / Grounded</option>
                      <option value="major">🟠 Major Faults</option>
                      <option value="minor">🟡 Minor Faults</option>
                    </select>
                  </div>

                  <div className="flex items-center gap-2">
                    <span className="text-[10px] font-mono text-zinc-400 uppercase tracking-widest">Status Loop:</span>
                    <select
                      value={galleryStatusFilter}
                      onChange={(e: any) => setGalleryStatusFilter(e.target.value)}
                      className="bg-black/40 border border-[#1F2937] text-xs font-semibold text-white rounded-xl px-3.5 py-2 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500/20"
                    >
                      <option value="all">All Statuses</option>
                      <option value="open">Open Faults</option>
                      <option value="in_repair">In Active Repair</option>
                      <option value="closed">Closed / Repaired</option>
                    </select>
                  </div>
                </div>
              </div>

              {/* 1. GALLERY VIEW MODE */}
              {defectViewMode === 'gallery' && (
                <div className="flex flex-col gap-6">
                  <div className="flex justify-between items-center">
                    <h4 className="font-display text-sm font-black text-zinc-300 tracking-wider uppercase">
                      🔍 VISUAL AUDIT FIELD GRID (
                      {
                        defects.filter(def => {
                          const severityMatches = gallerySeverityFilter === 'all' || def.severity === gallerySeverityFilter;
                          const statusMatches = galleryStatusFilter === 'all' || def.status === galleryStatusFilter;
                          return severityMatches && statusMatches;
                        }).length
                      } items matched)
                    </h4>
                  </div>

                  <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    {defects
                      .filter(def => {
                        const severityMatches = gallerySeverityFilter === 'all' || def.severity === gallerySeverityFilter;
                        const statusMatches = galleryStatusFilter === 'all' || def.status === galleryStatusFilter;
                        return severityMatches && statusMatches;
                      })
                      .map(def => {
                        const v = vehicles.find(vh => vh.id === def.vehicleId);
                        const c = checks.find(chk => chk.id === def.checkId);
                        const isDangerous = def.severity === 'dangerous';
                        const isMajor = def.severity === 'major';

                        return (
                          <div 
                            key={def.id} 
                            className="bg-[#111827] rounded-3xl border border-[#1F2937] hover:border-zinc-700 transition-all duration-300 overflow-hidden shadow-xl hover:shadow-2xl flex flex-col relative group"
                          >
                            {/* Severity Badge overlay */}
                            <div className="absolute left-3 top-3 z-10">
                              <span className={`px-2.5 py-1 rounded-sm text-[9px] font-mono font-black uppercase tracking-widest shadow-lg ${
                                isDangerous
                                  ? 'bg-rose-600 text-white' 
                                  : isMajor 
                                  ? 'bg-orange-500 text-white' 
                                  : 'bg-amber-400 text-zinc-950'
                              }`}>
                                {def.severity}
                              </span>
                            </div>

                            {/* Status Badge overlay */}
                            <div className="absolute right-3 top-3 z-10">
                              <span className={`px-2.5 py-1 rounded-full text-[9px] font-mono font-black uppercase tracking-wider border backdrop-blur-md ${
                                def.status === 'open'
                                  ? 'bg-rose-500/10 border-rose-500/30 text-rose-400'
                                  : def.status === 'in_repair'
                                  ? 'bg-amber-500/10 border-amber-550/30 text-amber-400 font-bold'
                                  : 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400'
                              }`}>
                                {def.status === 'open' ? '🔴 OPEN' : def.status === 'in_repair' ? '🔧 TRIAGED' : '✓ REPAIRED'}
                              </span>
                            </div>

                            {/* Captured Photo or CAD blueprint representation */}
                            <div className="relative h-44 bg-slate-950 overflow-hidden flex items-center justify-center border-b border-[#1F2937] shrink-0">
                              {def.photoUrl ? (
                                <img
                                  src={def.photoUrl}
                                  alt={def.itemLabel}
                                  className="w-full h-full object-cover group-hover:scale-105 transition-all duration-300 cursor-pointer"
                                  onClick={() => setSelectedGalleryDefect(def)}
                                  referrerPolicy="no-referrer"
                                />
                              ) : (
                                <div 
                                  onClick={() => setSelectedGalleryDefect(def)}
                                  className="w-full h-full flex items-center justify-center cursor-pointer hover:bg-slate-900/45 transition-colors"
                                >
                                  {/* High-end CAD vector sketch */}
                                  <svg className="w-full h-full bg-slate-900/60 p-4 text-zinc-500 stroke-1" viewBox="0 0 120 50" fill="none" stroke="currentColor">
                                    <path d="M5 32h110v3H5zm0 0l5-12h25l3 12M40 32V10h70v22M5 32V25h6" strokeLinejoin="round" />
                                    <circle cx="20" cy="36" r="4.5" />
                                    <circle cx="28" cy="36" r="4.5" />
                                    <circle cx="85" cy="36" r="4.5" />
                                    <circle cx="95" cy="36" r="4.5" />
                                    <path d="M0 5h120M0 15h120M0 25h120M0 35h120M0 45h120" stroke="rgba(255,255,255,0.03)" strokeWidth="0.5" />
                                    <circle cx="60" cy="20" r="10" stroke="rgba(244,63,94,0.3)" strokeDasharray="2,2" />
                                    <path d="M60 5v30M45 20h30" stroke="rgba(244,63,94,0.3)" strokeWidth="0.5" />
                                    <text x="60" y="22" textAnchor="middle" fontSize="3" fill="rgba(244,63,94,0.7)" className="font-mono uppercase font-black tracking-widest">AWAITING PHOTO CAPTURE</text>
                                  </svg>
                                </div>
                              )}
                            </div>

                            {/* Card Details Body */}
                            <div className="p-5 flex-1 flex flex-col justify-between">
                              <div className="space-y-2">
                                <span className="text-[10px] font-mono text-zinc-500 block uppercase tracking-wide">
                                  LOGGED ON {new Date(def.createdAt).toLocaleDateString("en-GB")}
                                </span>
                                <h5 className="font-display text-sm font-bold text-white tracking-tight">{def.itemLabel}</h5>
                                <p className="text-zinc-400 text-xs line-clamp-2 leading-relaxed h-8">{def.description}</p>
                              </div>

                              <div className="border-t border-[#1F2937]/75 pt-3.5 mt-3 flex flex-col gap-3">
                                <div className="flex items-center justify-between gap-1.5">
                                  {/* Professional UK style registration plate block */}
                                  <div className={`inline-flex items-center rounded overflow-hidden select-none border border-neutral-700 font-mono text-xs font-extrabold ${
                                    v?.type === 'lgv' ? 'uk-plate-white' : 'uk-plate-yellow'
                                  }`}>
                                    <div className="bg-blue-700 text-white text-[8px] font-sans font-bold flex flex-col justify-center items-center px-1.5 py-0.5 border-r border-[#1F2937]/10 h-6 shrink-0">
                                      <span className="text-[6px] leading-[4px] font-black uppercase tracking-wider block">UK</span>
                                    </div>
                                    <div className="px-2.5 py-0.5 text-[11px] leading-tight text-neutral-950 font-black tracking-wider uppercase text-center min-w-[70px]">
                                      {v?.registration || "ASSET"}
                                    </div>
                                  </div>

                                  <span className="text-[10px] text-zinc-500 font-medium truncate">({v?.make} {v?.model})</span>
                                </div>

                                <button
                                  type="button"
                                  onClick={() => setSelectedGalleryDefect(def)}
                                  className="w-full bg-[#1C2535] text-white hover:bg-[#253248] text-[10px] uppercase font-display font-extrabold py-2 px-3 rounded-xl transition-all tracking-widest border border-[#374151]/50 text-center"
                                >
                                  Inspect Details & Repair
                                </button>
                              </div>
                            </div>
                          </div>
                        );
                      })}

                    {defects.filter(def => {
                      const severityMatches = gallerySeverityFilter === 'all' || def.severity === gallerySeverityFilter;
                      const statusMatches = galleryStatusFilter === 'all' || def.status === galleryStatusFilter;
                      return severityMatches && statusMatches;
                    }).length === 0 && (
                      <div className="col-span-full bg-[#111827] p-8 rounded-3xl border border-[#1F2937] text-center text-zinc-400 text-xs">
                        No defects correspond to the selected severity and status filter parameters.
                      </div>
                    )}
                  </div>
                </div>
              )}

              {/* 2. STANDARD LIST VIEW MODE */}
              {defectViewMode === 'list' && (
                <div className="flex flex-col gap-4">
                  <h4 className="font-display text-sm font-black text-zinc-300 tracking-wider">
                    ⚠️ ACTIVE COMPLIANCE DEFECTS ON-SITE ({defects.filter(d => d.status !== 'closed').length})
                  </h4>

                  {defects
                    .filter(def => {
                      const severityMatches = gallerySeverityFilter === 'all' || def.severity === gallerySeverityFilter;
                      const statusMatches = galleryStatusFilter === 'all' || def.status === galleryStatusFilter;
                      return severityMatches && statusMatches;
                    })
                    .map(def => {
                      const v = vehicles.find(vh => vh.id === def.vehicleId);
                      const isRepairing = repairingDefectId === def.id;

                      return (
                        <div key={def.id} className="bg-[#111827] rounded-3xl border border-[#1F2937]/80 p-6 relative overflow-hidden shadow-lg">
                          <div className="absolute right-4 top-4">
                            <span className={`px-3 py-1 font-mono text-xs font-bold rounded-sm uppercase tracking-wider ${
                              def.severity === 'dangerous' ? 'bg-red-600 text-white' : def.severity === 'major' ? 'bg-orange-500 text-white' : 'bg-yellow-400 text-slate-950'
                            }`}>
                              {def.severity === 'dangerous' ? '🔴 DANGEROUS — GROUNDED' : def.severity === 'major' ? '🟠 MAJOR FAULT' : '🟡 MINOR'}
                            </span>
                          </div>

                          <div className="flex flex-col lg:flex-row gap-6">
                            
                            {/* Detail text */}
                            <div className="flex-1">
                              <div className="flex gap-2 items-center mb-2">
                                <span className={`inline-flex items-center rounded overflow-hidden select-none border border-neutral-700 font-mono text-xs font-extrabold ${
                                  v?.type === 'lgv' ? 'uk-plate-white' : 'uk-plate-yellow'
                                }`}>
                                  <div className="bg-blue-700 text-white text-[8px] font-sans font-bold flex flex-col justify-center items-center px-1.5 py-0.5 border-r border-[#1F2937]/10 h-5 shrink-0">
                                    <span className="text-[6px] leading-[4px] font-black uppercase tracking-wider block">UK</span>
                                  </div>
                                  <div className="px-2 py-0.5 text-[10px] leading-tight text-neutral-950 font-black tracking-wider uppercase text-center min-w-[55px]">
                                    {v?.registration || "ASSET"}
                                  </div>
                                </span>
                                <span className="text-zinc-400 text-xs ml-1">Failed system:</span>
                                <span className="font-bold text-white text-xs">{def.itemLabel}</span>
                              </div>

                              <p className="text-zinc-200 text-sm font-semibold mt-3">{def.description}</p>
                              <span className="text-[11px] text-zinc-500 block mt-2 font-mono">Archive Log: {new Date(def.createdAt).toLocaleDateString("en-GB")} UTC</span>

                              {!isRepairing && (
                                <button
                                  type="button"
                                  onClick={() => {
                                    setRepairingDefectId(def.id);
                                    setRepairNotes("");
                                    setRepairParts("");
                                    setEngineerSignature("");
                                  }}
                                  className="mt-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-display text-xs font-bold py-2 px-4.5 rounded-lg inline-flex items-center gap-1.5 shrink-0 shadow-md uppercase transition-all tracking-wide"
                                >
                                  ⚙️ MARK AS REPAIRED (ENGINEER SIGN-OFF)
                                </button>
                              )}
                            </div>

                            {/* Defect image */}
                            <div className="w-full lg:w-48 bg-black/40 rounded-2xl overflow-hidden border border-[#1F2937] shrink-0 flex items-center justify-center text-center">
                              {def.photoUrl ? (
                                <img 
                                  src={def.photoUrl} 
                                  alt="Captured screenshot" 
                                  className="h-48 lg:h-32 w-full object-cover bg-slate-900"
                                  referrerPolicy="no-referrer"
                                />
                              ) : (
                                <span className="text-[10px] text-zinc-500 p-4 font-mono uppercase">No photo recorded</span>
                              )}
                            </div>
                          </div>

                          {/* Expanding Repair Sign-off widget */}
                          {isRepairing && (
                            <form onSubmit={handleRepairSubmit} className="mt-5 pt-5 border-t border-[#1F2937] bg-black/35 p-4 rounded-2xl flex flex-col gap-4 text-xs">
                              <div className="flex justify-between items-center">
                                <span className="font-bold text-white uppercase tracking-widest font-mono text-[10px] text-gradient">🔧 CERTIFICATION ENGINE REPAIR PROCESS RECORD</span>
                                <button type="button" onClick={() => setRepairingDefectId(null)} className="text-rose-400 font-mono text-[10px] font-bold hover:underline py-0.5 px-2">Cancel</button>
                              </div>

                              <div className="grid grid-cols-2 gap-4">
                                <div>
                                  <label className="text-zinc-450 uppercase tracking-wider block font-bold mb-1 text-[9px] font-mono">Certified Engineer Full Name</label>
                                  <input
                                    type="text"
                                    required
                                    value={engineerName}
                                    onChange={(e) => setEngineerName(e.target.value)}
                                    className="w-full bg-black border border-[#1F2937] rounded-xl p-2.5 text-white font-sans focus:outline-none focus:border-blue-500"
                                  />
                                </div>
                                
                                <div>
                                  <label className="text-zinc-450 uppercase tracking-wider block font-bold mb-1 text-[9px] font-mono">Equipment Parts Deployed</label>
                                  <input
                                    type="text"
                                    required
                                    value={repairParts}
                                    onChange={(e) => setRepairParts(e.target.value)}
                                    placeholder="e.g. 1x replacement outer headbulb assembly"
                                    className="w-full bg-black border border-[#1F2937] rounded-xl p-2.5 text-white focus:outline-none focus:border-blue-500"
                                  />
                                </div>

                                <div className="col-span-2">
                                  <label className="text-zinc-450 uppercase tracking-wider block font-bold mb-1 text-[9px] font-mono">Repair Execution Notes</label>
                                  <textarea
                                    required
                                    value={repairNotes}
                                    onChange={(e) => setRepairNotes(e.target.value)}
                                    placeholder="Describe precisely how the roadworthiness defect was resolved (e.g. Cleared connectors, sealed rubber gaskets, and tested standard output OK.)"
                                    rows={2}
                                    className="w-full bg-black border border-[#1F2937] rounded-xl p-2.5 text-white focus:outline-none focus:border-blue-500"
                                  />
                                </div>

                                <div className="col-span-2">
                                  <label className="text-zinc-450 uppercase tracking-wider block font-bold mb-1 text-[9px] font-mono">Engineer Digital Seal Signature</label>
                                  <div className="rounded-2xl overflow-hidden border border-[#1F2937] bg-white p-1">
                                    <SignaturePad
                                      onSave={(data) => setEngineerSignature(data)}
                                      placeholderText="Draw engineer signature on-screen to certify legal compliance"
                                      id="engineer-repair-sigp"
                                    />
                                  </div>
                                </div>
                              </div>

                              <button
                                type="submit"
                                disabled={!engineerSignature || !repairNotes}
                                className="bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-display text-sm font-bold py-3 rounded-xl mt-2 uppercase disabled:opacity-40 shadow-lg shadow-emerald-500/10 cursor-pointer text-center"
                              >
                                ✓ SUBMIT COMPLIANCE REPAIR Certification
                              </button>
                            </form>
                          )}
                        </div>
                      );
                    })}

                  {defects.filter(d => d.status !== 'closed').length === 0 && (
                    <div className="bg-[#111827] p-8 rounded-3xl border border-emerald-500/20 text-center text-emerald-400 font-sans text-xs">
                      ✓ Clean bill of health. All vehicle defect compliance reports are closed and fully repaired!
                    </div>
                  )}
                </div>
              )}

              {/* 3. HISTORIC RESOLVED DEFECTS Collapsible Ledger */}
              <div className="bg-[#111827] border border-[#1F2937] rounded-3xl p-6 shadow-xl mt-2">
                <span className="font-display text-xs font-black text-zinc-450 uppercase tracking-widest block mb-4">HISTORIC RESOLVED DEFECTS JOURNAL</span>
                
                <div className="flex flex-col gap-2.5">
                  {defects.filter(d => d.status === 'closed').map(def => {
                    const v = vehicles.find(vh => vh.id === def.vehicleId);
                    return (
                      <div key={def.id} className="p-4 bg-black/40 border border-[#1F2937] rounded-xl text-xs flex flex-col md:flex-row gap-3 justify-between items-start md:items-center">
                        <div className="flex flex-wrap items-center gap-2">
                          <span className={`inline-flex items-center rounded overflow-hidden select-none border border-neutral-700 font-mono text-xs font-extrabold ${
                            v?.type === 'lgv' ? 'uk-plate-white' : 'uk-plate-yellow'
                          }`}>
                            <div className="bg-blue-700 text-white text-[8px] font-sans font-bold flex flex-col justify-center items-center px-1 py-0.5 border-r border-[#1F2937]/10 h-5 shrink-0">
                              <span className="text-[5px] leading-[4px] font-black uppercase tracking-wider block">UK</span>
                            </div>
                            <div className="px-1.5 py-0.5 text-[9px] leading-tight text-neutral-950 font-black tracking-wider uppercase text-center min-w-[50px]">
                              {v?.registration || "ASSET"}
                            </div>
                          </span>
                          <span className="font-bold text-white">{def.itemLabel}</span> — 
                          <span className="text-zinc-400 italic font-medium"> {def.description}</span>
                        </div>
                        <div className="flex items-center gap-3 shrink-0">
                          <span className="text-[9px] font-mono text-zinc-500">Repaired on {def.repairCompletedAt ? new Date(def.repairCompletedAt).toLocaleDateString("en-GB") : new Date(def.createdAt).toLocaleDateString("en-GB")}</span>
                          <span className="font-mono text-[9px] bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 px-2.5 py-1 rounded-full font-black uppercase tracking-wider">
                            RESOLVED ✓
                          </span>
                        </div>
                      </div>
                    );
                  })}

                  {defects.filter(d => d.status === 'closed').length === 0 && (
                    <span className="text-xs text-zinc-500 italic">No closed historic defects logged onto active session database.</span>
                  )}
                </div>
              </div>

              {/* INTERACTIVE COMPREHENSIVE GALLERY INSPECTION OVERLAY MODAL (FLEETIO-STYLE VERIFICATION GRAPH) */}
              {selectedGalleryDefect && (() => {
                const def = selectedGalleryDefect;
                const v = vehicles.find(vh => vh.id === def.vehicleId);
                const chk = checks.find(c => c.id === def.checkId);
                const isDangerous = def.severity === 'dangerous';
                const isMajor = def.severity === 'major';
                const reporterDriver = drivers.find(d => d.id === chk?.driverId);

                return (
                  <div className="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/85 backdrop-blur-md animate-fade-in select-text">
                    <div className="bg-[#111827] border border-[#1F2937] rounded-3xl shadow-2xl overflow-hidden w-full max-w-4xl max-h-[90vh] flex flex-col">
                      {/* Modal top header bar */}
                      <div className="p-5 border-b border-[#1F2937] bg-black/20 flex justify-between items-center shrink-0">
                        <div className="space-y-1">
                          <span className="text-[10px] font-mono font-black text-amber-500 uppercase tracking-widest block">SECURE DVSA AUDIT TRIAL RECORD</span>
                          <h4 className="font-display text-base font-black text-white uppercase tracking-tight">Defect ID: {def.id.slice(0, 12)}</h4>
                        </div>
                        <button
                          type="button"
                          onClick={() => setSelectedGalleryDefect(null)}
                          className="bg-zinc-800 hover:bg-zinc-700 text-white p-2 rounded-xl transition-colors cursor-pointer"
                        >
                          <X className="w-4 h-4" />
                        </button>
                      </div>

                      {/* Modal scrollable contents box */}
                      <div className="flex-1 p-6 overflow-y-auto space-y-6">
                        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                          
                          {/* Image inspection zone */}
                          <div className="space-y-4">
                            <span className="text-[10px] font-mono text-zinc-400 uppercase tracking-widest block font-bold mb-1">Visual Evidence (Driver Snap)</span>
                            <div className="bg-black rounded-2xl border border-[#1F2937] h-64 overflow-hidden relative group flex items-center justify-center">
                              {def.photoUrl ? (
                                <>
                                  <img
                                    src={def.photoUrl}
                                    alt="Visual defect snapshot"
                                    className="w-full h-full object-contain cursor-zoom-in group-hover:scale-105 duration-500 transition-all referrerPolicy='no-referrer'"
                                  />
                                  <div className="absolute bottom-2.5 right-2.5 bg-black/60 backdrop-blur-md text-white text-[9px] font-mono px-2 py-1 rounded">
                                    ✓ PHOTO CAPTURED
                                  </div>
                                </>
                              ) : (
                                <div className="p-6 text-center text-zinc-500">
                                  <svg className="w-16 h-16 mx-auto mb-3 text-zinc-650" viewBox="0 0 120 50" fill="none" stroke="currentColor">
                                    <path d="M5 32h110v3H5zm0 0l5-12h25l3 12M40 32V10h70v22" strokeWidth="1" />
                                    <circle cx="20" cy="36" r="4.5" />
                                    <circle cx="28" cy="36" r="4.5" />
                                  </svg>
                                  <span className="text-[10.5px] font-mono uppercase tracking-wider block text-rose-400">No Physical Snap Attached</span>
                                  <p className="text-[10px] text-zinc-500 mt-1 max-w-[200px] mx-auto">Driver certified damage log via description parameters only.</p>
                                </div>
                              )}
                            </div>

                            <div className="p-4 bg-black/40 border border-[#1F2937] rounded-2xl flex items-center justify-between text-xs font-mono text-zinc-400">
                              <span>DVSA Code Match:</span>
                              <span className="font-bold text-white uppercase bg-zinc-800 px-2 py-0.5 rounded text-[10px]">REF: SECT-{def.itemKey}</span>
                            </div>
                          </div>

                          {/* Data audit & triage loops */}
                          <div className="space-y-5">
                            <div className="space-y-2">
                              {/* UK registration plate */}
                              <div className="flex items-center gap-2">
                                <div className={`inline-flex items-center rounded overflow-hidden select-none border border-neutral-700 font-mono text-xs font-extrabold ${
                                  v?.type === 'lgv' ? 'uk-plate-white' : 'uk-plate-yellow'
                                }`}>
                                  <div className="bg-blue-700 text-white text-[8px] font-sans font-bold flex flex-col justify-center items-center px-1.5 py-0.5 border-r border-[#1F2937]/10 h-6 shrink-0">
                                    <span className="text-[6px] leading-[4px] font-black uppercase tracking-wider block">UK</span>
                                  </div>
                                  <div className="px-3 py-0.5 text-[11px] leading-tight text-neutral-950 font-black tracking-wider uppercase text-center min-w-[70px]">
                                    {v?.registration || "ASSET"}
                                  </div>
                                </div>
                                <span className="text-zinc-400 text-xs font-medium">({v?.make} {v?.model} — {v?.year})</span>
                              </div>

                              <h4 className="text-base font-black text-white font-display mt-2">{def.itemLabel}</h4>
                              <p className="text-sm text-zinc-300 leading-relaxed font-semibold bg-black/25 p-4 border border-[#1F2937]/55 rounded-2xl">{def.description}</p>
                            </div>

                            <div className="grid grid-cols-2 gap-3.5 text-xs font-display">
                              <div className="bg-black/30 border border-[#1F2937] p-3 rounded-2xl">
                                <span className="text-zinc-500 block text-[9px] uppercase tracking-wider font-mono">Reported By</span>
                                <span className="text-white font-bold">{reporterDriver?.fullName || "Assigned Driver"}</span>
                              </div>
                              <div className="bg-black/30 border border-[#1F2937] p-3 rounded-2xl">
                                <span className="text-zinc-500 block text-[9px] uppercase tracking-wider font-mono">Inspected On</span>
                                <span className="text-white font-bold font-mono">{new Date(def.createdAt).toLocaleDateString("en-GB")}</span>
                              </div>
                            </div>

                            {/* Geographic location and maps coordinates metadata */}
                            <div className="bg-black/40 border border-[#1F2937] p-4 rounded-2xl space-y-2">
                              <span className="text-zinc-500 text-[9px] uppercase tracking-widest font-mono block">Inspection Geo-Tags (Reporter GPS)</span>
                              <div className="flex items-center justify-between">
                                <span className="font-mono text-xs text-zinc-300">
                                  {chk?.latitude && chk?.longitude ? (
                                    <span>Lat: {chk.latitude.toFixed(5)}° N, Long: {chk.longitude.toFixed(5)}° W</span>
                                  ) : (
                                    <span className="text-zinc-500 italic">No GPS coordinates attached (Wi-Fi triangulation bypass)</span>
                                  )}
                                </span>
                                {chk?.latitude && chk?.longitude && (
                                  <a
                                    href={`https://www.google.com/maps/search/?api=1&query=${chk.latitude},${chk.longitude}`}
                                    target="_blank"
                                    rel="noreferrer"
                                    className="bg-blue-600/20 text-blue-400 border border-blue-500/20 hover:border-blue-500/50 hover:bg-blue-600/30 font-bold font-mono text-[9px] px-3 py-1.5 rounded-xl transition-colors shrink-0"
                                  >
                                    📍 GOOGLE MAPS
                                  </a>
                                )}
                              </div>
                            </div>

                            {/* Driver Signature Seal display */}
                            {chk?.driverSignature && (
                              <div className="p-4 bg-black/40 border border-[#1F2937] rounded-2xl space-y-2">
                                <span className="text-zinc-500 text-[9px] uppercase tracking-widest font-mono block">Reporter Signature (Digital Seal)</span>
                                <div className="bg-white rounded-lg p-1.5 max-w-[150px] inline-block">
                                  <img
                                    src={chk.driverSignature}
                                    alt="Driver Digital Compliance Seal"
                                    className="h-10 object-contain text-black referrerPolicy='no-referrer'"
                                  />
                                </div>
                              </div>
                            )}
                          </div>
                        </div>

                        {/* Interactive Mechanic Repair Activation Loop inside audit dialog */}
                        {def.status !== 'closed' ? (
                          <div className="border-t border-[#1F2937] pt-6 space-y-4">
                            <h5 className="font-display text-sm font-black text-white uppercase tracking-wider flex items-center gap-1.5">
                              🔧 Mechanic Repair Certification Activation
                            </h5>
                            
                            {repairingDefectId !== def.id ? (
                              <button
                                type="button"
                                onClick={() => {
                                  setRepairingDefectId(def.id);
                                  setRepairNotes("");
                                  setRepairParts("");
                                  setEngineerSignature("");
                                }}
                                className="w-full bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-display text-sm font-black py-3 rounded-2xl transition-all shadow-lg tracking-widest uppercase text-center cursor-pointer"
                              >
                                Certify Defect Resolution / Mechanic Sign-off
                              </button>
                            ) : (
                              <form 
                                onSubmit={async (e) => {
                                  e.preventDefault();
                                  if (!engineerSignature) {
                                    alert("Mechanic digital seal is required.");
                                    return;
                                  }
                                  await onCloseDefect(def.id, {
                                    engineerName,
                                    repairDescription: repairNotes,
                                    partsUsed: repairParts,
                                    engineerSignature
                                  });
                                  setRepairingDefectId(null);
                                  setSelectedGalleryDefect(null);
                                }}
                                className="bg-black/35 border border-[#1F2937] p-5 rounded-2xl flex flex-col gap-4 text-xs animate-slide-up"
                              >
                                <div className="flex justify-between items-center">
                                  <span className="font-bold text-white uppercase tracking-widest font-mono text-[10px]">Active Worksheet</span>
                                  <button type="button" onClick={() => setRepairingDefectId(null)} className="text-rose-400 font-bold hover:underline py-0.5 px-2 font-mono">Cancel Form</button>
                                </div>

                                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                                  <div>
                                    <label className="text-zinc-400 uppercase tracking-wider block font-bold mb-1 font-mono text-[9px]">Mechanic License Name</label>
                                    <input
                                      type="text"
                                      required
                                      value={engineerName}
                                      onChange={(e) => setEngineerName(e.target.value)}
                                      className="w-full bg-black border border-[#1F2937] rounded-xl p-2.5 text-white font-sans focus:outline-none focus:border-blue-500"
                                    />
                                  </div>
                                  
                                  <div>
                                    <label className="text-zinc-400 uppercase tracking-wider block font-bold mb-1 font-mono text-[9px]">Equipment Deployments</label>
                                    <input
                                      type="text"
                                      required
                                      value={repairParts}
                                      onChange={(e) => setRepairParts(e.target.value)}
                                      placeholder="e.g. 1x brand-new light bulb block"
                                      className="w-full bg-black border border-[#1F2937] rounded-xl p-2.5 text-white focus:outline-none"
                                    />
                                  </div>

                                  <div className="col-span-1 md:col-span-2">
                                    <label className="text-zinc-400 uppercase tracking-wider block font-bold mb-1 font-mono text-[9px]">Notes of repair procedure</label>
                                    <textarea
                                      required
                                      value={repairNotes}
                                      onChange={(e) => setRepairNotes(e.target.value)}
                                      rows={2}
                                      className="w-full bg-black border border-[#1F2937] rounded-xl p-2.5 text-white"
                                    />
                                  </div>

                                  <div className="col-span-1 md:col-span-2">
                                    <label className="text-zinc-400 uppercase tracking-wider block font-bold mb-1 font-mono text-[9px]">Mechanic Compliance Signature</label>
                                    <div className="rounded-2xl border border-[#1F2937] bg-white p-1">
                                      <SignaturePad
                                        onSave={(sig) => setEngineerSignature(sig)}
                                        placeholderText="Authorized signature for legal safety sign-off"
                                        id="modal-engineer-sig"
                                      />
                                    </div>
                                  </div>
                                </div>

                                <button
                                  type="submit"
                                  disabled={!engineerSignature || !repairNotes}
                                  className="bg-emerald-600 hover:bg-emerald-500 text-white font-display text-xs font-black py-3 rounded-xl uppercase tracking-widest disabled:opacity-40 transition-colors shadow-lg cursor-pointer"
                                >
                                  Submit Reparation Certification
                                </button>
                              </form>
                            )}
                          </div>
                        ) : (
                          <div className="border-t border-[#1F2937] pt-6 mt-4 p-4 bg-emerald-500/5 rounded-2xl border border-emerald-500/10 text-emerald-400 space-y-2">
                            <span className="font-mono text-[10px] uppercase font-black tracking-widest block text-emerald-500">✓ CERTIFIED LEGAL RESOLUTION RECORDED</span>
                            <p className="text-xs">
                              This roadworthiness hazard is closed. Resolved by <strong className="text-white">{def.engineerName}</strong> on {def.repairCompletedAt ? new Date(def.repairCompletedAt).toLocaleDateString("en-GB") : new Date().toLocaleDateString("en-GB")}.
                            </p>
                            {def.repairDescription && <p className="text-[11px] text-zinc-400">Notes: {def.repairDescription}</p>}
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                );
              })()}

            </div>
          )}

          {/* TAB 5: COMPLIANCE LOGS */}
          {activeTab === 'records' && (
            <div className="flex flex-col gap-5">
              
              {/* Search filter bar */}
              <div className="bg-white p-4 border border-slate-200 rounded-2xl shadow-xs flex flex-col md:flex-row gap-3 justify-between items-center">
                <div className="relative flex-1 w-full text-xs">
                  <Search className="w-4 h-4 text-slate-400 absolute left-3 top-1/2 transform -translate-y-1/2" />
                  <input
                    type="text"
                    value={globalSearch}
                    onChange={(e) => setGlobalSearch(e.target.value)}
                    placeholder="Search logs by operator vehicle plate, driver name, result, date..."
                    className="w-full bg-slate-50 border border-slate-200 rounded-xl pl-10 pr-4 py-2.5 outline-hidden focus:border-amber-500"
                  />
                </div>

                <div className="flex flex-col md:flex-row gap-2 w-full md:w-auto">
                  <div className="w-full md:w-44">
                    <CustomSelect
                      value={vehicleFilter}
                      onChange={(val) => setVehicleFilter(val)}
                      placeholder="All Vehicles"
                      options={[
                        { value: "all", label: "All Vehicles" },
                        ...vehicles.map(v => ({ value: v.id, label: v.registration }))
                      ]}
                    />
                  </div>

                  <div className="w-full md:w-44">
                    <CustomSelect
                      value={statusFilter}
                      onChange={(val) => setStatusFilter(val)}
                      placeholder="All Statuses"
                      options={[
                        { value: "all", label: "All Statuses" },
                        { value: "nil_defect", label: "Nil Defect" },
                        { value: "defect", label: "Defects Logged" }
                      ]}
                    />
                  </div>
                </div>
              </div>

              {/* Records tabular grid */}
              <div className="bg-white rounded-3xl border border-slate-200 shadow-xs overflow-hidden">
                <table className="w-full text-left text-xs">
                  <thead>
                    <tr className="bg-slate-50 text-slate-500 uppercase font-mono tracking-wider font-semibold border-b border-slate-200">
                      <th className="py-3 px-4">Checked Date</th>
                      <th className="py-3 px-4">Registration</th>
                      <th className="py-3 px-4">Driver Name</th>
                      <th className="py-3 px-4 text-center">Check Duration</th>
                      <th className="py-3 px-4 text-center">GPS Log</th>
                      <th className="py-3 px-4">Compliance Status</th>
                      <th className="py-3 px-4 text-right">DVSA A4 Document</th>
                    </tr>
                  </thead>
                  <tbody>
                    {checks
                      .filter(c => {
                        const v = vehicles.find(vh => vh.id === c.vehicleId);
                        const d = drivers.find(dr => dr.id === c.driverId);
                        
                        // Search evaluation
                        const targetStr = `${v?.registration} ${d?.fullName} ${c.checkDate} ${c.result}`.toLowerCase();
                        const matchesSearch = targetStr.includes(globalSearch.toLowerCase());
                        
                        // Filter matching
                        const matchesVehicle = vehicleFilter === 'all' || c.vehicleId === vehicleFilter;
                        const matchesStatus = statusFilter === 'all' || c.result === statusFilter;
                        
                        return matchesSearch && matchesVehicle && matchesStatus;
                      })
                      .sort((a,b) => new Date(b.startedAt).getTime() - new Date(a.startedAt).getTime())
                      .map(ch => {
                        const v = vehicles.find(vh => vh.id === ch.vehicleId);
                        const d = drivers.find(dr => dr.id === ch.driverId);
                        const m = Math.floor((ch.durationSeconds || 0)/60);
                        const s = (ch.durationSeconds || 0)%60;

                        return (
                          <tr key={ch.id} className="border-b border-slate-100 hover:bg-slate-50/50 transition-colors">
                            <td className="py-3.5 px-4 font-bold text-slate-900">{ch.checkDate}</td>
                            <td className="py-3.5 px-4">
                              <span className="reg-plate text-[10px] font-bold py-0.5 px-1.5">{v?.registration}</span>
                            </td>
                            <td className="py-3.5 px-4 font-semibold text-slate-800">{d?.fullName}</td>
                            <td className="py-3.5 px-4 text-center font-mono font-bold text-slate-500">
                              {m}m {s}s 
                              <span className="text-[10px] text-slate-400 block font-normal mt-0.5">Min Ref: {v?.type === 'lgv' ? (company.minDurationLgv !== undefined ? company.minDurationLgv : 5) : v?.type === 'hgv' ? (company.minDurationHgv !== undefined ? company.minDurationHgv : 10) : (company.minDurationHgvTrailer !== undefined ? company.minDurationHgvTrailer : 15)}m</span>
                              {ch.quickCheckAlert && (
                                <span className="text-[10px] text-amber-500 bg-amber-50 border border-amber-100 px-1 mt-1 rounded font-bold inline-block">⏱️ UNDER-TIME</span>
                              )}
                            </td>
                            <td className="py-3.5 px-4 text-center">
                              {ch.latitude ? (
                                <span className="inline-flex items-center gap-1 bg-emerald-50 text-emerald-700 border border-emerald-200 px-1.5 py-0.5 rounded text-[9px] font-bold uppercase transition-all" title={`${ch.latitude.toFixed(5)}, ${ch.longitude?.toFixed(5)}`}>
                                  <MapPin className="w-2.5 h-2.5" /> OK
                                </span>
                              ) : (
                                <span className="inline-flex items-center gap-1 bg-slate-100 text-slate-400 px-1.5 py-0.5 rounded text-[9px] font-bold uppercase">
                                  N/A
                                </span>
                              )}
                            </td>
                            <td className="py-3.5 px-4">
                              <span className={`px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase ${
                                ch.result === 'nil_defect' ? 'bg-emerald-100 text-emerald-800' : 'bg-orange-100 text-orange-850'
                              }`}>
                                {ch.result === 'nil_defect' ? '✓ Nil Defect' : '⚠️ Defect Logged'}
                              </span>
                            </td>
                            <td className="py-3.5 px-4 text-right">
                              <div className="flex gap-2 justify-end">
                                <button
                                  onClick={() => setViewingCheck(ch)}
                                  className="text-[11px] font-bold text-slate-600 bg-slate-100 border border-slate-200 hover:bg-slate-200 px-2 py-1 rounded"
                                >
                                  Review
                                </button>
                                <button
                                  onClick={() => triggerPdfDownload(ch)}
                                  className="bg-slate-900 hover:bg-slate-800 text-white font-mono text-[10px] font-bold px-2 py-1 rounded inline-flex items-center gap-0.5"
                                >
                                  <Download className="w-3 h-3 text-amber-500" /> A4 PDF
                                </button>
                              </div>
                            </td>
                          </tr>
                        );
                      })}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          {/* TAB 6: SETTINGS */}
          {activeTab === 'settings' && (
            <div className="bg-white rounded-3xl border border-slate-200 shadow-xs p-6 max-w-xl">
              <h3 className="font-display text-lg font-bold text-slate-950 mb-4 border-b border-slate-100 pb-3">
                COMPANY COMPLIANCE CONTRACTS
              </h3>

              <form onSubmit={handleSaveCompany} className="flex flex-col gap-4 text-xs">
                <div>
                  <label className="text-slate-400 uppercase tracking-wider block font-bold mb-1">Company Registered Name</label>
                  <input
                    type="text"
                    required
                    value={compName}
                    onChange={(e) => setCompName(e.target.value)}
                    className="w-full bg-slate-50 border border-slate-300 rounded p-2.5 text-slate-800 text-sm focus:outline-hidden"
                  />
                  <span className="text-[10px] text-slate-500 mt-1 block">As stated in your commercial operator permits.</span>
                </div>

                <div>
                  <label className="text-slate-400 uppercase tracking-wider block font-bold mb-1">Company Work Email (Sign-in Identifier)</label>
                  <input
                    type="email"
                    required
                    value={compEmail}
                    onChange={(e) => setCompEmail(e.target.value)}
                    className="w-full bg-slate-50 border border-slate-300 rounded p-2.5 text-slate-800 text-sm focus:outline-hidden"
                  />
                  <span className="text-[10px] text-slate-500 mt-1 block">Used for Fleet Manager login. Must be unique.</span>
                </div>

                <div>
                  <label className="text-slate-400 uppercase tracking-wider block font-bold mb-1">Fleet Manager Password</label>
                  <input
                    type="password"
                    required
                    value={compPassword}
                    onChange={(e) => setCompPassword(e.target.value)}
                    className="w-full bg-slate-50 border border-slate-300 rounded p-2.5 text-slate-800 text-sm focus:outline-hidden"
                  />
                  <span className="text-[10px] text-slate-500 mt-1 block">Secure password for administrative dashboard access.</span>
                </div>

                <div>
                  <label className="text-slate-400 uppercase tracking-wider block font-bold mb-1">UK O-Licence Number (Optional)</label>
                  <input
                    type="text"
                    value={compLicence}
                    onChange={(e) => setCompLicence(e.target.value)}
                    placeholder="OM1234567"
                    className="w-full bg-slate-50 border border-slate-300 rounded p-2.5 text-slate-850 font-mono focus:outline-hidden"
                  />
                  <span className="text-[10px] text-slate-500 mt-1 block">Your legal Department for Transport reference identifier</span>
                </div>

                <div className="border-t border-slate-100 pt-4 mt-2">
                  <h4 className="font-display text-sm font-bold text-slate-900 mb-2 uppercase tracking-wide">
                    Walkaround Duration Settings
                  </h4>
                  <p className="text-[10.5px] text-slate-500 mb-3 leading-relaxed">
                    Configure minimum expected check durations (in minutes) per vehicle type config. Under-time checks are flagged logic-alert flags for review in list records, but do not block driver completion submissions in compliance with Solo guidelines.
                  </p>
                  <div className="grid grid-cols-3 gap-3">
                    <div>
                      <label className="text-slate-400 uppercase tracking-wider block font-bold mb-1 font-mono text-[9px]">Rigid Van (LGV)</label>
                      <input
                        type="number"
                        min="0"
                        required
                        value={minLgv}
                        onChange={(e) => setMinLgv(Number(e.target.value))}
                        className="w-full bg-slate-50 border border-slate-300 rounded p-2 text-slate-805 text-xs font-mono font-bold focus:outline-hidden"
                      />
                      <span className="text-[9px] text-slate-400 block mt-1">Recommended: 5m</span>
                    </div>
                    <div>
                      <label className="text-slate-400 uppercase tracking-wider block font-bold mb-1 font-mono text-[9px]">HGV Rigid Core</label>
                      <input
                        type="number"
                        min="0"
                        required
                        value={minHgv}
                        onChange={(e) => setMinHgv(Number(e.target.value))}
                        className="w-full bg-slate-50 border border-slate-300 rounded p-2 text-slate-805 text-xs font-mono font-bold focus:outline-hidden"
                      />
                      <span className="text-[9px] text-slate-400 block mt-1">Recommended: 10m</span>
                    </div>
                    <div>
                      <label className="text-slate-400 uppercase tracking-wider block font-bold mb-1 font-mono text-[9px]">Artic Trailer</label>
                      <input
                        type="number"
                        min="0"
                        required
                        value={minHgvTrailer}
                        onChange={(e) => setMinHgvTrailer(Number(e.target.value))}
                        className="w-full bg-slate-50 border border-slate-300 rounded p-2 text-slate-805 text-xs font-mono font-bold focus:outline-hidden"
                      />
                      <span className="text-[9px] text-slate-400 block mt-1">Recommended: 15m</span>
                    </div>
                  </div>
                </div>

                <div className="p-3.5 bg-amber-50 border border-amber-100 rounded-xl flex flex-col gap-1">
                  <span className="text-[11px] text-amber-800 font-bold block uppercase tracking-wider font-mono">
                    Active Plan: {company.plan === 'owner-driver' ? 'Owner-Driver' : company.plan === 'starter' ? 'Starter Fleet (14-day Free Trial Active)' : 'Growth Fleet Pro'}
                  </span>
                  <p className="text-[10.5px] text-amber-700 leading-relaxed mt-1">
                    Your active license plan limits are: <strong>Max {company.vehicleLimit} vehicles</strong>. Need larger fleet size limits or more advanced integrations? Contact Operator support at support@walksafe.co.uk anytime.
                  </p>
                </div>

                {compSavedMsg && (
                  <div className="text-emerald-700 font-bold animate-pulse">
                    ✓ Operator characteristics saved instantly! Sync complete on server-side disk configuration.
                  </div>
                )}
                
                {compErrorMsg && (
                  <div className="text-red-600 font-bold bg-red-50 p-2 rounded border border-red-100">
                    ⚠️ {compErrorMsg}
                  </div>
                )}

                <button
                  type="submit"
                  className="bg-slate-900 border border-slate-850 hover:bg-slate-800 text-white font-display text-sm font-bold py-2.5 rounded-lg uppercase mt-2 shadow-xs"
                >
                  Save settings
                </button>
              </form>

              {/* Real-time System Notifications Setup Card */}
              <div className="mt-8 pt-6 border-t border-slate-100">
                <h3 className="font-display text-lg font-bold text-slate-950 mb-1 uppercase">
                  🔔 System-Wide Push Alerts 
                </h3>
                <p className="text-xs text-slate-400 mt-1 mb-4">
                  WalkSafe triggers native OS-level alerts when vehicles are grounded, severe defects are logged by drivers, or new scheduled compliance checkups are created.
                </p>

                <div className="space-y-4">
                  <div className="flex justify-between items-center bg-slate-50 p-3 rounded-xl border border-slate-200">
                    <div>
                      <span className="text-slate-400 text-[10px] uppercase font-mono block">System Permission Status</span>
                      <span className={`text-xs font-bold uppercase ${notifPermission === 'granted' ? 'text-emerald-600' : 'text-amber-600'}`}>
                        {notifPermission === 'granted' ? '✓ Granted' : notifPermission === 'denied' ? '✗ Blocked' : '⏳ Action Required'}
                      </span>
                    </div>
                    {notifPermission !== 'granted' ? (
                      <button
                        type="button"
                        onClick={requestPermission}
                        className="px-3 py-1.5 bg-amber-500 hover:bg-amber-650 text-slate-950 text-xs font-bold rounded-lg transition-colors cursor-pointer border-0"
                      >
                        Enable Browser Alerts
                      </button>
                    ) : (
                      <span className="text-[11px] font-mono text-emerald-600 font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100">
                        Active
                      </span>
                    )}
                  </div>

                  <div className="bg-slate-50 p-4 rounded-xl border border-slate-200 text-xs text-slate-500 leading-relaxed font-mono">
                    <span className="text-slate-800 font-bold uppercase tracking-wide block mb-1">How background alerts execute</span>
                    To receive background and off-screen push notifications safely, please ensure you open the app in its own browser tab via the <strong className="text-amber-600 font-bold">"Open in new tab"</strong> button if testing inside development previews, or install the app onto your mobile/desktop homescreen!
                  </div>

                  <button
                    type="button"
                    onClick={async () => {
                      try {
                        const response = await fetch("/api/push/test", {
                          method: "POST",
                          headers: { "Content-Type": "application/json" },
                          body: JSON.stringify({ companyId: company.id })
                        });
                        if (response.ok) {
                          alert("Push notification request sent! Check your operating system alerts tray. If it didn't arrive, check notification/chime permissions under your browser settings bar.");
                        }
                      } catch (e) {
                        alert("Error invoking test push trigger.");
                      }
                    }}
                    className="w-full py-2 px-3 bg-slate-900 border border-slate-850 hover:bg-slate-800 text-amber-400 font-mono font-bold text-xs uppercase rounded-lg text-center cursor-pointer shadow-xs"
                  >
                    ⚡ Trigger instant system-level push test
                  </button>
                </div>
              </div>

            </div>
          )}

          {/* TAB 9: BILLING */}
          {activeTab === 'billing' && (
            <div className="space-y-6">
              
              {/* Billing Header Metrics Cards */}
              <div className="grid grid-cols-1 md:grid-cols-3 gap-5">
                
                {/* Active Plan details card */}
                <div className="bg-white rounded-3xl border border-slate-200 shadow-xs p-6 flex flex-col justify-between">
                  <div>
                    <span className="text-slate-400 text-[10px] uppercase font-mono block tracking-wider mb-1">Active Membership</span>
                    <h4 className="font-display font-black text-2xl text-slate-900 uppercase">
                      {company.plan === 'owner-driver' ? 'Solo Owner-Driver' : company.plan === 'starter' ? 'Starter Fleet' : company.plan === 'growth' ? 'Growth Fleet Pro' : 'Enterprise Scale'}
                    </h4>
                    <span className="mt-2 text-xs font-mono bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-full font-bold inline-block">
                      ✓ Active Subscribed
                    </span>
                  </div>
                  <div className="mt-6 border-t border-slate-100 pt-3">
                    <p className="text-xs text-slate-500 leading-normal">
                      Renewal rate: <strong className="text-slate-800">{company.plan === 'owner-driver' ? '£4.99' : company.plan === 'starter' ? '£14.99' : company.plan === 'growth' ? '£34.99' : '£84.99'} / month</strong>
                    </p>
                    <p className="text-[11px] text-slate-450 mt-1">
                      Next auto-charge: June 30, 2026
                    </p>
                  </div>
                </div>

                {/* Fleet capacity metrics card */}
                <div className="bg-white rounded-3xl border border-slate-200 shadow-xs p-6 flex flex-col justify-between">
                  <div>
                    <span className="text-slate-400 text-[10px] uppercase font-mono block tracking-wider mb-1">Fleet Allowance Capacity</span>
                    <div className="flex items-baseline gap-1.5 mt-1">
                      <span className="font-display font-black text-4xl text-slate-900">{vehicles.length}</span>
                      <span className="text-slate-400 text-sm">/ {company.vehicleLimit} vehicles active</span>
                    </div>

                    {/* Progress slider bar metric */}
                    <div className="w-full bg-slate-100 h-2 rounded-full overflow-hidden mt-4">
                      <div 
                        className={`h-full rounded-full transition-all duration-500 ${
                          (vehicles.length / company.vehicleLimit) > 0.85 ? 'bg-rose-500' : 'bg-emerald-500'
                        }`}
                        style={{ width: `${Math.min(100, (vehicles.length / company.vehicleLimit) * 100)}%` }}
                      ></div>
                    </div>
                  </div>
                  <div className="mt-4 text-xs text-slate-500">
                    {company.vehicleLimit - vehicles.length} vehicle slots remain open under your active license tier.
                  </div>
                </div>

                {/* Virtual holographic Payment Method card wrapper */}
                <div className="relative group">
                  <div className="absolute -inset-0.5 bg-gradient-to-r from-teal-500 to-indigo-500 rounded-[28px] blur-xs opacity-30 group-hover:opacity-60 transition duration-500"></div>
                  
                  {/* Holographic Digital Visual Payment Card */}
                  <div className="relative bg-gradient-to-br from-slate-900 via-slate-950 to-indigo-950 text-white rounded-[26px] p-6 shadow-xl flex flex-col justify-between h-48 select-none">
                    <div className="flex justify-between items-start">
                      <div>
                        <span className="text-[9px] uppercase tracking-widest font-mono text-slate-400">Premium Operator Card</span>
                        <h4 className="font-display font-bold text-sm tracking-wide mt-0.5">{company.name}</h4>
                      </div>
                      {/* Contactless symbol styled with pure nested divs */}
                      <div className="flex gap-0.5 items-center">
                        <div className="w-1 h-3.5 bg-slate-300/40 rounded-full"></div>
                        <div className="w-1 h-4 bg-slate-200/60 rounded-full"></div>
                        <div className="w-1 h-4.5 bg-slate-100/80 rounded-full"></div>
                      </div>
                    </div>

                    <div className="my-2">
                      <span className="text-sm font-mono tracking-widest block text-teal-400 font-bold">
                        ••••  ••••  ••••  4242
                      </span>
