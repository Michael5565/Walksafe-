                    <div className="flex justify-between items-end">
                      <div>
                        <span className="text-[8px] uppercase tracking-widest text-slate-500 block font-mono">Expiry</span>
                        <span className="text-xs font-mono font-bold text-slate-300">12/29</span>
                      </div>
                      <div className="flex flex-col items-end">
                        <span className="text-[8px] uppercase tracking-widest text-slate-500 block font-mono">Carrier Corp</span>
                        <span className="text-xs font-black italic text-teal-300 font-sans tracking-tight">WalkSafe PAY</span>
                      </div>
                    </div>
                  </div>
                </div>

