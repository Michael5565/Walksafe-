import React, { useState, useRef, useEffect } from "react";
import { 
  Shield, Truck, AlertTriangle, CheckCircle, RefreshCw, X, Plus, 
  Search, Download, Users, Wrench, FileText, Check, Settings, 
  MapPin, Calendar, Clock, Lock, Trash2, Edit, AlertOctagon, Menu, ChevronDown, LogOut, ShieldCheck, ArrowRight, CreditCard
} from "lucide-react";
import { Vehicle, Driver, WalkaroundCheck, Defect, Company, Announcement, ScheduledChecklist, Notification as WalkSafeNotification } from "../types";
import { generateDVSA_PDF } from "../utils/pdfGenerator";
import { isScheduleDueToday } from "../utils/scheduleUtils";
