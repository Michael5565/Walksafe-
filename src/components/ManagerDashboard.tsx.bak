                      : 'border-slate-200 hover:border-slate-300 bg-white'
                  }`}>
                    <div>
                      <span className="text-[9px] font-mono uppercase bg-slate-100 text-slate-600 font-bold px-1.5 py-0.5 rounded">Solo Operator</span>
                      <h5 className="font-display text-base font-bold text-slate-900 mt-2">Owner-Driver</h5>
                      <span className="text-slate-400 text-xs block mt-1">Single asset operators</span>
                      
