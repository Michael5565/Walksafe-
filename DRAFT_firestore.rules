rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      // The user email from runtime
      return isSignedIn() && request.auth.token.email == 'michaelnwokobia60@gmail.com'; 
    }

    // Validation Helpers
    function isValidCompany(data) {
      return data.keys().hasAll(['id', 'name']) &&
             data.id is string && data.id.size() <= 64 &&
             data.name is string && data.name.size() <= 200;
    }

    function isValidVehicle(data) {
      return data.keys().hasAll(['id', 'companyId', 'registration']) &&
             data.id is string &&
             data.companyId is string &&
             data.registration is string && data.registration.size() <= 15;
    }

    function isValidDriver(data) {
      return data.keys().hasAll(['id', 'companyId', 'fullName']) &&
             data.id is string &&
             data.companyId is string &&
             data.fullName is string && data.fullName.size() <= 200;
    }

    function isValidCheck(data) {
      return data.keys().hasAll(['id', 'vehicleId', 'driverId', 'companyId']) &&
             data.id is string &&
             data.vehicleId is string &&
             data.driverId is string &&
             data.companyId is string;
    }

    function isValidDefect(data) {
      return data.keys().hasAll(['id', 'checkId', 'vehicleId', 'companyId']) &&
             data.id is string &&
             data.checkId is string &&
             data.vehicleId is string &&
             data.companyId is string;
    }

    function isValidPushSubscription(data) {
      return data.keys().hasAll(['token', 'companyId']) &&
             data.token is string &&
             data.companyId is string;
    }

    // Match Rules
    match /companies/{companyId} {
      allow read: if isSignedIn(); // Simplified for now, should ideally be restricted to members
      allow create, update: if isSignedIn() && isValidCompany(incoming());
      
      match /vehicles/{vehicleId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && isValidVehicle(incoming());
      }
      
      match /drivers/{driverId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && isValidDriver(incoming());
      }
      
      match /checks/{checkId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidCheck(incoming());
      }
      
      match /defects/{defectId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && isValidDefect(incoming());
      }
    }

    match /push_subscriptions/{tokenId} {
      allow read: if isAdmin();
      allow create, update: if isSignedIn() && isValidPushSubscription(incoming());
    }
  }
}
